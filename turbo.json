{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "cacheDir": ".turbo/cache",
  "globalEnv": ["TURBO_RUNTIME_HASH", "npm_config_user_agent"],
  "globalPassThroughEnv": ["TURBO_FORCE"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/**"],
      "outputs": [".next/**", "!.next/cache/**", ".source/**", "content/docs/skills/**"]
    },
    "test": {
      "outputs": []
    },
    "docs#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/.claude/skills/**",
        "$TURBO_ROOT$/skills-lock.json",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": []
    },
    "verify": {
      "outputs": []
    },
    "docs#verify": {
      "cache": false
    },
    "types:check": {
      "outputs": []
    },
    "docs#types:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/**"],
      "outputs": [".source/**", ".next/types/**", "content/docs/skills/**"]
    }
  }
}
