{
  "schemaVersion": 1,
  "skill": "woostack-fix",
  "cases": [
    {
      "id": "blocks-before-issue-when-root-cause-is-unproven",
      "prompt": "Evaluate the bounded synthetic fix investigation in fixtures/no-root-cause.json. Its requestedPlanPath is a legacy request, not authority. Do not edit, create, or mutate anything. Apply the packaged skill contract and return exactly one JSON object using the keys status, rootCauseEstablished, issueBound, branchCreated, localDevelopmentRecordCreated, and mergeAllowed.",
      "fixtures": [
        "no-root-cause.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The flow blocks before issue binding or Git because no root cause is proved, rejects the requested local fix record, and never merges.",
      "assertions": [
        {
          "id": "root-cause-blocker",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "root-cause-not-established",
          "kind": "final-json-path-equals",
          "pointer": "/rootCauseEstablished",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-issue-before-root-cause",
          "kind": "final-json-path-equals",
          "pointer": "/issueBound",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-branch-before-root-cause",
          "kind": "final-json-path-equals",
          "pointer": "/branchCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-local-development-record",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentRecordCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "legacy-request-path-absent",
          "kind": "path-absent",
          "path": ".woostack/fixes/cache-stampede.md",
          "critical": true
        },
        {
          "id": "fix-never-merges-on-block",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "exact-project-approval-persists-hierarchy-and-delegates",
      "prompt": "Evaluate fixtures/selected-project-persistence.json as the state immediately after explicit approve-to-execute. The caller supplied the exact project and repository Linear policy is absent. Do not call a provider, run Git, or implement. Apply the packaged skill contract and return exactly one JSON object using the keys artifactModeSelected, repositoryPolicyPresent, canonicalRepositoryVerified, workspaceTeamVerified, projectId, projectCreated, preMutationHierarchyReadComplete, parentPlanIssueId, incrementChildIssueIds, hierarchyReadBackVerified, approvedProjectContextReadBackVerified, hardGates, executionDelegated, executionSkill, executionArtifactContext, prTrailer, and mergeAllowed.",
      "fixtures": [
        "selected-project-persistence.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The exact caller-supplied project selects persistence even without repository policy. Canonical repository and workspace/team verification precede one project/parent/child hierarchy read-back, then the approved increment is delegated to woostack-execute with exact persisted context, no standalone trailer, and no merge.",
      "assertions": [
        {
          "id": "exact-project-selects-artifact-mode",
          "kind": "final-json-path-equals",
          "pointer": "/artifactModeSelected",
          "expected": true,
          "critical": true
        },
        {
          "id": "policy-is-absent",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryPolicyPresent",
          "expected": false,
          "critical": true
        },
        {
          "id": "canonical-repository-verified",
          "kind": "final-json-path-equals",
          "pointer": "/canonicalRepositoryVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "workspace-team-verified",
          "kind": "final-json-path-equals",
          "pointer": "/workspaceTeamVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "exact-project-retained",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": "project-feature-9",
          "critical": true
        },
        {
          "id": "selected-project-is-not-created",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "pre-write-hierarchy-sets-are-complete",
          "kind": "final-json-path-equals",
          "pointer": "/preMutationHierarchyReadComplete",
          "expected": true,
          "critical": true
        },
        {
          "id": "parent-plan-retained",
          "kind": "final-json-path-equals",
          "pointer": "/parentPlanIssueId",
          "expected": "issue-app-241",
          "critical": true
        },
        {
          "id": "single-increment-child",
          "kind": "final-json-path-equals",
          "pointer": "/incrementChildIssueIds",
          "expected": [
            "issue-app-242"
          ],
          "critical": true
        },
        {
          "id": "hierarchy-read-back",
          "kind": "final-json-path-equals",
          "pointer": "/hierarchyReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "approved-project-context-read-back",
          "kind": "final-json-path-equals",
          "pointer": "/approvedProjectContextReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "exact-one-gate",
          "kind": "final-json-path-equals",
          "pointer": "/hardGates",
          "expected": [
            "approve-to-execute"
          ],
          "critical": true
        },
        {
          "id": "execution-is-delegated",
          "kind": "final-json-path-equals",
          "pointer": "/executionDelegated",
          "expected": true,
          "critical": true
        },
        {
          "id": "execute-owns-implementation",
          "kind": "final-json-path-equals",
          "pointer": "/executionSkill",
          "expected": "woostack-execute",
          "critical": true
        },
        {
          "id": "exact-artifact-context",
          "kind": "final-json-path-equals",
          "pointer": "/executionArtifactContext",
          "expected": {
            "projectId": "project-feature-9",
            "parentPlanIssueId": "issue-app-241",
            "incrementChildIssueId": "issue-app-242"
          },
          "critical": true
        },
        {
          "id": "no-standalone-trailer",
          "kind": "final-json-path-equals",
          "pointer": "/prTrailer",
          "expected": null,
          "critical": true
        },
        {
          "id": "fix-never-merges-after-approval",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "partial-selected-project-hierarchy-blocks-before-delegation",
      "prompt": "Evaluate only fixtures/selected-project-persistence.json partialReadScenario at the approved persistence boundary. Do not infer unread pages, call a provider, run Git, or implement. Return exactly one JSON object using the keys status, reasonCode, projectCreated, providerMutationCount, hierarchyReadBackVerified, and executionDelegated.",
      "fixtures": [
        "selected-project-persistence.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "An incomplete selected-project hierarchy read blocks before provider mutation or execution delegation and never creates a replacement project.",
      "assertions": [
        {
          "id": "partial-hierarchy-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "partial-hierarchy-reason",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "incomplete-hierarchy-readback",
          "critical": true
        },
        {
          "id": "partial-hierarchy-does-not-create-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "partial-hierarchy-does-not-mutate-provider",
          "kind": "final-json-path-equals",
          "pointer": "/providerMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "partial-hierarchy-is-not-verified",
          "kind": "final-json-path-equals",
          "pointer": "/hierarchyReadBackVerified",
          "expected": false,
          "critical": true
        },
        {
          "id": "partial-hierarchy-does-not-delegate",
          "kind": "final-json-path-equals",
          "pointer": "/executionDelegated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "explicit-create-uses-stable-project-parent-child-identities",
      "prompt": "Evaluate fixtures/explicit-project-create.json at the selected persistence boundary. No exact project exists; the caller explicitly requested persistence. Do not call a provider or run Git. Return exactly one JSON object using the keys artifactModeSelected, canonicalRepositoryVerified, workspaceTeamVerified, absenceProvedBeforeCreate, projectMutationId, parentMutationId, childMutationIds, createAttempts, independentReadBacksVerified, approvedProjectContextReadBackVerified, retryMatchedExistingHierarchy, replacementCreated, and branchCreated.",
      "fixtures": [
        "explicit-project-create.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Explicit persistence proves the preallocated project identity absent, attempts one project create, and treats its timeout as unknown. An immediate complete lookup of the same identity recovers exactly one project before any parent write. Parent and child use their retained identities, every resource is independently read back, and no branch, replay, or replacement is created.",
      "assertions": [
        {
          "id": "explicit-request-selects-artifact-mode",
          "kind": "final-json-path-equals",
          "pointer": "/artifactModeSelected",
          "expected": true,
          "critical": true
        },
        {
          "id": "create-repository-verified",
          "kind": "final-json-path-equals",
          "pointer": "/canonicalRepositoryVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "create-workspace-team-verified",
          "kind": "final-json-path-equals",
          "pointer": "/workspaceTeamVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "absence-proved-before-create",
          "kind": "final-json-path-equals",
          "pointer": "/absenceProvedBeforeCreate",
          "expected": true,
          "critical": true
        },
        {
          "id": "stable-project-mutation-id",
          "kind": "final-json-path-equals",
          "pointer": "/projectMutationId",
          "expected": "21111111-1111-4111-8111-111111111111",
          "critical": true
        },
        {
          "id": "stable-parent-mutation-id",
          "kind": "final-json-path-equals",
          "pointer": "/parentMutationId",
          "expected": "22222222-2222-4222-8222-222222222222",
          "critical": true
        },
        {
          "id": "stable-child-mutation-id",
          "kind": "final-json-path-equals",
          "pointer": "/childMutationIds",
          "expected": [
            "23333333-3333-4333-8333-333333333333"
          ],
          "critical": true
        },
        {
          "id": "single-create-pass",
          "kind": "final-json-path-equals",
          "pointer": "/createAttempts",
          "expected": {
            "project": 1,
            "parent": 1,
            "children": 1,
            "parentChildLinks": 1
          },
          "critical": true
        },
        {
          "id": "complete-hierarchy-readback",
          "kind": "final-json-path-equals",
          "pointer": "/independentReadBacksVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "created-approved-project-context-read-back",
          "kind": "final-json-path-equals",
          "pointer": "/approvedProjectContextReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "retry-resumes-hierarchy",
          "kind": "final-json-path-equals",
          "pointer": "/retryMatchedExistingHierarchy",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-replacement",
          "kind": "final-json-path-equals",
          "pointer": "/replacementCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-branch-before-persistence-proof",
          "kind": "final-json-path-equals",
          "pointer": "/branchCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "classifies-exact-project-and-rejects-invalid-identities-before-git",
      "prompt": "Evaluate every entry in fixtures/exact-project-classification.json candidates as a separately caller-supplied --project identity. Derive each classification from the supplied kind, repository association, workspace/team membership, and role evidence. Do not repair, migrate, mutate, or run Git. Return exactly one JSON object using the keys status, decisions, repositoryMutationCount, branchCreated, and projectCreated.",
      "fixtures": [
        "exact-project-classification.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The exact canonical-repository project with resolved workspace/team is selected for later approved persistence. Ambiguous, foreign, issue, and document identities block their artifact paths before repository mutation; no new project or branch is created.",
      "assertions": [
        {
          "id": "identity-matrix-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "classified",
          "critical": true
        },
        {
          "id": "every-invalid-identity-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": {
            "ambiguousIssue": "blocked",
            "foreignRepository": "blocked",
            "foreignTeam": "blocked",
            "featureProject": "selected",
            "projectIncrement": "blocked",
            "linearDocument": "blocked"
          },
          "critical": true
        },
        {
          "id": "identity-failure-no-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "identity-failure-no-branch",
          "kind": "final-json-path-equals",
          "pointer": "/branchCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "identity-failure-no-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "receipt-owner-evidence-and-authority-conflicts-fail-closed",
      "fixturePassthroughAssertions": [
        {
          "assertionId": "conflicts-stop-branch",
          "fixture": "approved-fix.json",
          "pointer": "/safeCreate/branchCreated"
        }
      ],
      "prompt": "Evaluate every entry in fixtures/approved-fix.json blockedScenarios independently at the next mutation boundary. Do not use fallback credentials, custom transport, local development records, or inferred evidence. Return exactly one JSON object using the keys status, decisions, repositoryMutationCount, branchCreated, projectCreated, stableIdsPreserved, localDevelopmentRecordCreated, and mergeAllowed. decisions must map every blockedScenarios key to blocked.",
      "fixtures": [
        "approved-fix.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Owner drift, partial or unknown read-back, wrong lifecycle/evidence, local authority, repository credentials, custom Linear transport, and missing official MCP capability all stop with stable IDs preserved and zero repository mutation.",
      "assertions": [
        {
          "id": "conflict-matrix-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "every-conflict-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": {
            "ownershipChanged": "blocked",
            "partialReadBack": "blocked",
            "unknownReadBack": "blocked",
            "wrongLifecycle": "blocked",
            "wrongEvidence": "blocked",
            "localDevelopmentRecord": "blocked",
            "repositoryCredential": "blocked",
            "customLinearTransport": "blocked",
            "officialMcpUnavailable": "blocked"
          },
          "critical": true
        },
        {
          "id": "conflicts-stop-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "conflicts-stop-branch",
          "kind": "final-json-path-equals",
          "pointer": "/branchCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "conflicts-never-create-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "unknown-outcome-preserves-ids",
          "kind": "final-json-path-equals",
          "pointer": "/stableIdsPreserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-local-fallback",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentRecordCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-local-fix-file",
          "kind": "path-absent",
          "path": ".woostack/fixes/2026-07-26-cache-stampede.md",
          "critical": true
        },
        {
          "id": "conflicts-never-merge",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        }
      ]
    }
  ]
