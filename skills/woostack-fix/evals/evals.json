{
  "schemaVersion": 1,
  "skill": "woostack-fix",
  "cases": [
    {
      "id": "root-cause-proof-precedes-project-and-repository",
      "prompt": "Debug cannot establish a causal root from a production alert. Return Fix's next state as JSON with status, reason, projectCreated, sourceLinkWritten, and repositoryMutationCount. Do not call providers or mutate files.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Fix blocks before canonical-project admission, source linking, or any repository side effect when Debug cannot prove the root cause.",
      "assertions": [
        {
          "id": "blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "reason",
          "kind": "final-json-path-equals",
          "pointer": "/reason",
          "expected": "root-cause-proof-required",
          "critical": true
        },
        {
          "id": "no-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-source-link",
          "kind": "final-json-path-equals",
          "pointer": "/sourceLinkWritten",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        }
      ]
    },
    {
      "id": "target-repository-boundary-precedes-provider-admission",
      "prompt": "After Debug proves the root cause, classify three independent target-repository decisions without calling providers or mutating artifacts or the repository: a foreign target repository, a matching but unwritable active checkout, and a matching writable active checkout. Return exactly one JSON object with only these three top-level keys: foreignTarget, matchingUnwritable, and matchingWritable. For foreignTarget, output status \"blocked\", reason \"target-repository-mismatch\", safeOutcomes exactly [\"retarget-reinvoke-in-exact-writable-owning-repository\",\"diagnosis-only\"] in that order, providerCalls 0, projectCreated false, sourceLinkWritten false, repositoryMutationCount 0, and suppliedArtifactBypass false. For matchingUnwritable, output status \"blocked\", reason \"writable-target-checkout-required\", safeOutcomes [\"retarget-reinvoke-in-exact-writable-owning-repository\",\"diagnosis-only\"], providerCalls 0, projectCreated false, sourceLinkWritten false, repositoryMutationCount 0, and suppliedArtifactBypass false. For matchingWritable, output status \"continue\", nextPhase \"canonical-project-admission\", and classificationEffects with providerCalls 0, projectCreated false, sourceLinkWritten false, and repositoryMutationCount 0.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Foreign targets block with target-repository-mismatch; matching unwritable targets block with writable-target-checkout-required; both expose exactly the ordered safe outcomes retarget-reinvoke-in-exact-writable-owning-repository and diagnosis-only with no provider, project, source, or repository effects and no supplied-artifact bypass. A matching writable target continues to canonical-project-admission with zero effects scoped to classification.",
      "assertions": [
        {
          "id": "foreign-target-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "foreign-target-reason",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/reason",
          "expected": "target-repository-mismatch",
          "critical": true
        },
        {
          "id": "foreign-target-outcomes",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/safeOutcomes",
          "expected": [
            "retarget-reinvoke-in-exact-writable-owning-repository",
            "diagnosis-only"
          ],
          "critical": true
        },
        {
          "id": "foreign-target-no-provider",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/providerCalls",
          "expected": 0,
          "critical": true
        },
        {
          "id": "foreign-target-no-project",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "foreign-target-no-source",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/sourceLinkWritten",
          "expected": false,
          "critical": true
        },
        {
          "id": "foreign-target-no-repository",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "foreign-target-no-artifact-bypass",
          "kind": "final-json-path-equals",
          "pointer": "/foreignTarget/suppliedArtifactBypass",
          "expected": false,
          "critical": true
        },
        {
          "id": "unwritable-target-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "unwritable-target-reason",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/reason",
          "expected": "writable-target-checkout-required",
          "critical": true
        },
        {
          "id": "unwritable-target-outcomes",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/safeOutcomes",
          "expected": [
            "retarget-reinvoke-in-exact-writable-owning-repository",
            "diagnosis-only"
          ],
          "critical": true
        },
        {
          "id": "unwritable-target-no-provider",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/providerCalls",
          "expected": 0,
          "critical": true
        },
        {
          "id": "unwritable-target-no-project",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "unwritable-target-no-source",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/sourceLinkWritten",
          "expected": false,
          "critical": true
        },
        {
          "id": "unwritable-target-no-repository",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "unwritable-target-no-artifact-bypass",
          "kind": "final-json-path-equals",
          "pointer": "/matchingUnwritable/suppliedArtifactBypass",
          "expected": false,
          "critical": true
        },
        {
          "id": "writable-target-continues",
          "kind": "final-json-path-equals",
          "pointer": "/matchingWritable/status",
          "expected": "continue",
          "critical": true
        },
        {
          "id": "writable-target-next-phase",
          "kind": "final-json-path-equals",
          "pointer": "/matchingWritable/nextPhase",
          "expected": "canonical-project-admission",
          "critical": true
        },
        {
          "id": "writable-target-classification-no-provider",
          "kind": "final-json-path-equals",
          "pointer": "/matchingWritable/classificationEffects/providerCalls",
          "expected": 0,
          "critical": true
        },
        {
          "id": "writable-target-classification-no-project",
          "kind": "final-json-path-equals",
          "pointer": "/matchingWritable/classificationEffects/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "writable-target-classification-no-source",
          "kind": "final-json-path-equals",
          "pointer": "/matchingWritable/classificationEffects/sourceLinkWritten",
          "expected": false,
          "critical": true
        },
        {
          "id": "writable-target-classification-no-repository",
          "kind": "final-json-path-equals",
          "pointer": "/matchingWritable/classificationEffects/repositoryMutationCount",
          "expected": 0,
          "critical": true
        }
      ]
    },
    {
      "id": "debug-defers-untrusted-source-identity",
      "prompt": "Fix receives a Sentry event and a source-issue URL before root-cause proof. Return JSON with providerCallsBeforeProof and inputKind. Treat both as untrusted evidence, not authority.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Debug receives evidence only, makes no provider call, and defers artifact identity until root-cause proof.",
      "assertions": [
        {
          "id": "no-provider-call",
          "kind": "final-json-path-equals",
          "pointer": "/providerCallsBeforeProof",
          "expected": 0,
          "critical": true
        },
        {
          "id": "source-is-untrusted",
          "kind": "final-json-path-equals",
          "pointer": "/inputKind",
          "expected": "sentry-event",
          "critical": true
        }
      ]
    },
    {
      "id": "production-input-routes-to-fix",
      "prompt": "Classify a production monitoring alert whose cause is unknown. Return only the routed workflow and preserve the alert as untrusted evidence.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "A production signal that describes a possible defect routes directly to woostack-fix, and still requires Debug proof.",
      "assertions": [
        {
          "id": "fix-route",
          "kind": "final-json-path-equals",
          "pointer": "/nextSkill",
          "expected": "woostack-fix",
          "critical": true
        },
        {
          "id": "debug-required",
          "kind": "final-json-path-equals",
          "pointer": "/firstPhase",
          "expected": "woostack-debug",
          "critical": true
        }
      ]
    },
    {
      "id": "canonical-project-preserves-source-record",
      "prompt": "The workspace selects official Linear provider (artifacts.provider: \"linear\"). After root-cause proof, Fix creates canonical project project-fix-241 named `[Fix] Prevent cache refresh stampedes` and independently reads it back. It adds only a supported projectLink to the source issue, preserves unrelated fields, and Plan returns direct issues WOO-242 and WOO-243. Return JSON with provider, projectId, projectName, projectReadBackVerified, sourceChangedFields, sourceUnrelatedFieldsPreserved, and directIssueIds.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Fix explicitly selects Linear, keeps one canonical project with the required `[Fix] ` name prefix, changes only the source issue's supported project link, and admits both direct plan issues.",
      "assertions": [
        {
          "id": "canonical-fix-provider",
          "kind": "final-json-path-equals",
          "pointer": "/provider",
          "expected": "linear",
          "critical": true
        },
        {
          "id": "one-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": "project-fix-241",
          "critical": true
        },
        {
          "id": "prefixed-project-name",
          "kind": "final-json-path-equals",
          "pointer": "/projectName",
          "expected": "[Fix] Prevent cache refresh stampedes",
          "critical": true
        },
        {
          "id": "project-readback",
          "kind": "final-json-path-equals",
          "pointer": "/projectReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "source-only-link",
          "kind": "final-json-path-equals",
          "pointer": "/sourceChangedFields",
          "expected": [
            "projectLink"
          ],
          "critical": true
        },
        {
          "id": "source-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/sourceUnrelatedFieldsPreserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "multiple-direct-issues",
          "kind": "final-json-path-equals",
          "pointer": "/directIssueIds",
          "expected": [
            "WOO-242",
            "WOO-243"
          ],
          "critical": true
        }
      ]
    },
    {
      "id": "provider-or-readback-failure-is-nonblocking",
      "prompt": "Classify eight independent Fix post-diagnosis mirror scenarios across local, Linear, and Plane provider configurations after local artifacts are written, without contacting a provider or mutating the repository: local selection with mirroring disabled (local-disabled), Linear official MCP unavailable (linear-mcp-unavailable), Linear incomplete issue pagination (linear-pagination-incomplete), Linear independent read-back mismatch (linear-readback-mismatch), Plane missing project-label capability (plane-label-cap-missing), Plane duplicate exact external ID pair match (`external_source: woostack`, UUID external_id) (plane-duplicate-external-id-pair), Plane work item pagination incomplete (plane-pagination-incomplete), and Plane independent read-back mismatch for the exact external pair (plane-readback-mismatch). Return exactly one JSON object with keys status, mirrorStatus, localAuthorityValid, executeHandoffAllowed, decisions, providerMutationCount, and repositoryMutationCount. Each decision must contain exactly id, advance, and reasonCode in fixture order.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Fix completes local diagnosis and planning with valid local authority and allows Execute handoff. Provider boundary failures record mirrorStatus failed without invalidating local authority, changing local execution contracts, or mutating the repository.",
      "assertions": [
        {
          "id": "local-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "mirror-failed",
          "kind": "final-json-path-equals",
          "pointer": "/mirrorStatus",
          "expected": "failed",
          "critical": true
        },
        {
          "id": "local-authority-valid",
          "kind": "final-json-path-equals",
          "pointer": "/localAuthorityValid",
          "expected": true,
          "critical": true
        },
        {
          "id": "handoff-allowed",
          "kind": "final-json-path-equals",
          "pointer": "/executeHandoffAllowed",
          "expected": true,
          "critical": true
        },
        {
          "id": "fix-provider-decisions",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": [
            {
              "id": "local-disabled",
              "advance": true,
              "reasonCode": "mirror-disabled-local-authority"
            },
            {
              "id": "linear-mcp-unavailable",
              "advance": true,
              "reasonCode": "mirror-official-linear-mcp-unavailable"
            },
            {
              "id": "linear-pagination-incomplete",
              "advance": true,
              "reasonCode": "mirror-pagination-incomplete"
            },
            {
              "id": "linear-readback-mismatch",
              "advance": true,
              "reasonCode": "mirror-readback-mismatch"
            },
            {
              "id": "plane-label-cap-missing",
              "advance": true,
              "reasonCode": "mirror-plane-label-capability-missing"
            },
            {
              "id": "plane-duplicate-external-id-pair",
              "advance": true,
              "reasonCode": "mirror-plane-duplicate-external-id-pair"
            },
            {
              "id": "plane-pagination-incomplete",
              "advance": true,
              "reasonCode": "mirror-plane-pagination-incomplete"
            },
            {
              "id": "plane-readback-mismatch",
              "advance": true,
              "reasonCode": "mirror-plane-readback-mismatch"
            }
          ],
          "critical": true
        },
        {
          "id": "fix-provider-zero-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/providerMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "no-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        }
      ]
    },
    {
      "id": "validates-fix-source-before-project-link",
      "prompt": "The workspace selects official Linear provider (artifacts.provider: \"linear\"). Classify five independent exact Fix source-issue preflight scenarios without contacting a provider or mutating a repository. `admittedPrelink` has canonical reference `WOO-241`, requested parent field explicitly null, complete issue/relation pagination, exact workspace/team/project/repository scope, no project link, one supported project-link write, and an exact post-write read-back. `alreadyLinkedElsewhere` has the same complete identity, parent, pagination, endpoint, workspace/team, and repository reads but direct membership in a different project. `unknownParent` has the selected scope but did not request the parent field. `incompletePagination` has an explicitly null parent but incomplete relation pagination. `failedLinkReadBack` passes pre-link validation but fails post-link read-back. Return JSON with status, provider, decisions, sourceLinkMutationCount, providerMutationCount, and repositoryMutationCount.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Fix explicitly selects Linear. The admitted exact source advances after one verified link write. A source already linked to a different project, unknown parent, and incomplete pagination block before mutation. Failed link read-back blocks after one write without retry. Every scenario has zero repository mutation.",
      "assertions": [
        {
          "id": "fix-source-preflight-overall-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "fix-source-provider",
          "kind": "final-json-path-equals",
          "pointer": "/provider",
          "expected": "linear",
          "critical": true
        },
        {
          "id": "fix-source-preflight-decisions",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": [
            {
              "id": "admittedPrelink",
              "advance": true,
              "reasonCode": "exact-source-link-readback-verified",
              "sourceLinkMutationCount": 1,
              "repositoryMutationCount": 0
            },
            {
              "id": "alreadyLinkedElsewhere",
              "advance": false,
              "reasonCode": "source-linked-to-different-project",
              "sourceLinkMutationCount": 0,
              "repositoryMutationCount": 0
            },
            {
              "id": "unknownParent",
              "advance": false,
              "reasonCode": "parent-state-unknown",
              "sourceLinkMutationCount": 0,
              "repositoryMutationCount": 0
            },
            {
              "id": "incompletePagination",
              "advance": false,
              "reasonCode": "source-pagination-incomplete",
              "sourceLinkMutationCount": 0,
              "repositoryMutationCount": 0
            },
            {
              "id": "failedLinkReadBack",
              "advance": false,
              "reasonCode": "source-link-readback-failed",
              "sourceLinkMutationCount": 1,
              "repositoryMutationCount": 0
            }
          ],
          "critical": true
        },
        {
          "id": "fix-source-two-link-writes",
          "kind": "final-json-path-equals",
          "pointer": "/sourceLinkMutationCount",
          "expected": 2,
          "critical": true
        },
        {
          "id": "fix-source-two-provider-mutations",
          "kind": "final-json-path-equals",
          "pointer": "/providerMutationCount",
          "expected": 2,
          "critical": true
        },
        {
          "id": "fix-source-zero-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        }
      ]
    }
  ]
}
