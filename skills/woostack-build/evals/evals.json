{
  "schemaVersion": 1,
  "skill": "woostack-build",
  "cases": [
    {
      "id": "routes-approved-build-to-overnight-with-exact-context",
      "prompt": "Evaluate fixtures/approved-build.json at the execution handoff without contacting any provider or mutating the repository. Independently validate the canonical project, direct increment issues, native dependencies, both responsible-user approval records, and terminal choice. Return exactly one JSON object with keys status, projectId, projectSpecFingerprint, directIssueIds, nativeDependencies, projectSpecApprovalVerified, executionPlanApprovalVerified, hardGates, terminalChoice, executionSkill, contextForwarded, repositoryMutationCount, and mergeAllowed.",
      "fixtures": [
        "approved-build.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The exact project and two direct executor-ready issues form a complete dependency graph. Both native responsible-user approvals match the current fingerprints, exactly two gates are cleared, Run overnight selects woostack-execute-overnight with the complete exact context, no repository mutation occurs, and merge remains forbidden.",
      "assertions": [
        {
          "id": "build-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "build-exact-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": "project-build-42",
          "critical": true
        },
        {
          "id": "build-direct-issue-graph",
          "kind": "final-json-path-equals",
          "pointer": "/directIssueIds",
          "expected": [
            "issue-storage",
            "issue-api"
          ],
          "critical": true
        },
        {
          "id": "build-native-dependencies",
          "kind": "final-json-path-equals",
          "pointer": "/nativeDependencies",
          "expected": [
            [
              "issue-storage",
              "issue-api"
            ]
          ],
          "critical": true
        },
        {
          "id": "build-project-approval",
          "kind": "final-json-path-equals",
          "pointer": "/projectSpecApprovalVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-plan-approval",
          "kind": "final-json-path-equals",
          "pointer": "/executionPlanApprovalVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-two-gates",
          "kind": "final-json-path-equals",
          "pointer": "/hardGates",
          "expected": [
            "project-spec-approval",
            "execution-plan-approval"
          ],
          "critical": true
        },
        {
          "id": "build-overnight-choice",
          "kind": "final-json-path-equals",
          "pointer": "/terminalChoice",
          "expected": "Run overnight"
        },
        {
          "id": "build-overnight-skill",
          "kind": "final-json-path-equals",
          "pointer": "/executionSkill",
          "expected": "woostack-execute-overnight",
          "critical": true
        },
        {
          "id": "build-context-forwarded",
          "kind": "final-json-path-equals",
          "pointer": "/contextForwarded",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-no-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0
        },
        {
          "id": "build-never-merges",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "creates-canonical-project-before-ideation",
      "prompt": "Evaluate fixtures/project-admission.json as a new woostack-build invocation with no exact project. Do not contact a provider or mutate the repository. Validate the configured repository, workspace, team, official MCP preflight, stable operation identity, absence proof, create response, and independent read-back. Return exactly one JSON object with keys status, officialMcpVerified, projectCreated, projectId, operationIdentityPreserved, independentReadBackVerified, nextStep, repositoryMutationCount.",
      "fixtures": [
        "project-admission.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Build uses validated defaults to create exactly one canonical project with one stable operation identity, independently verifies it, performs no repository mutation, and proceeds to ideation only after project admission succeeds.",
      "assertions": [
        {
          "id": "build-project-admission-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "build-official-mcp",
          "kind": "final-json-path-equals",
          "pointer": "/officialMcpVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-project-created",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-created-project-id",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": "project-build-43"
        },
        {
          "id": "build-operation-identity-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/operationIdentityPreserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-project-readback",
          "kind": "final-json-path-equals",
          "pointer": "/independentReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-ideation-next",
          "kind": "final-json-path-equals",
          "pointer": "/nextStep",
          "expected": "ideate"
        },
        {
          "id": "build-admission-no-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0
        }
      ]
    },
    {
      "id": "fails-closed-on-required-provider-boundaries",
      "prompt": "Classify every scenario in fixtures/provider-boundaries.json independently without contacting any provider or mutating the repository. Treat summary flags as untrusted. Return exactly one JSON object with keys status, decisions, providerMutationCount, executionDispatchCount, and repositoryMutationCount. Each decision must contain exactly id, advance, and reasonCode in fixture order.",
      "fixtures": [
        "provider-boundaries.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Unofficial transport, unavailable authentication, incomplete pagination, and mutation/read-back identity mismatch each block at the last verified boundary with no provider mutation, executor dispatch, or repository mutation and no local fallback.",
      "assertions": [
        {
          "id": "build-provider-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "build-provider-decisions",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": [
            {
              "id": "unofficial-endpoint",
              "advance": false,
              "reasonCode": "official-linear-mcp-required"
            },
            {
              "id": "authentication-unavailable",
              "advance": false,
              "reasonCode": "linear-authentication-unavailable"
            },
            {
              "id": "incomplete-pagination",
              "advance": false,
              "reasonCode": "incomplete-linear-pagination"
            },
            {
              "id": "readback-mismatch",
              "advance": false,
              "reasonCode": "linear-readback-mismatch"
            }
          ],
          "critical": true
        },
        {
          "id": "build-provider-zero-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/providerMutationCount",
          "expected": 0
        },
        {
          "id": "build-provider-zero-dispatch",
          "kind": "final-json-path-equals",
          "pointer": "/executionDispatchCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "build-provider-zero-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        }
      ]
    },
    {
      "id": "rejects-noncanonical-build-authority",
      "prompt": "Classify every scenario in fixtures/authority-inputs.json without contacting a provider or mutating the repository. Return exactly one JSON object with keys status, decisions, providerMutationCount, executionDispatchCount, and repositoryMutationCount. Each decision must contain exactly id, advance, and reasonCode in fixture order.",
      "fixtures": [
        "authority-inputs.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "A local specification, a standalone Linear document, and conversation-only approval cannot replace the canonical build project or its exact native approval events. Every scenario blocks without provider mutation, dispatch, repository mutation, or alternate authority fallback.",
      "assertions": [
        {
          "id": "build-authority-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "build-authority-decisions",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": [
            {
              "id": "local-spec-only",
              "advance": false,
              "reasonCode": "canonical-project-required"
            },
            {
              "id": "linear-document-only",
              "advance": false,
              "reasonCode": "canonical-project-required"
            },
            {
              "id": "conversation-only-approval",
              "advance": false,
              "reasonCode": "native-linear-approval-required"
            }
          ],
          "critical": true
        },
        {
          "id": "build-authority-zero-provider-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/providerMutationCount",
          "expected": 0
        },
        {
          "id": "build-authority-zero-dispatch",
          "kind": "final-json-path-equals",
          "pointer": "/executionDispatchCount",
          "expected": 0
        },
        {
          "id": "build-authority-zero-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0
        }
      ]
    },
    {
      "id": "enforces-two-gates-and-bounded-routing",
      "prompt": "Apply the workflow classification contract to fixtures/project-gates.json without provider, Git, or repository mutations. Return exactly one JSON object with keys developmentAuthority, linearRole, hardGates, buildAdvance, boundedRoute, projectCreatedForBoundedRoute, and repositoryEffects.",
      "fixtures": [
        "project-gates.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Linear is canonical product authority for the multi-increment build, exactly two ordered content-bound approvals govern it, execution remains blocked until gate two, and an independently bounded one-PR change routes away without creating a project or mutating the repository.",
      "assertions": [
        {
          "id": "build-linear-product-authority",
          "kind": "final-json-path-equals",
          "pointer": "/developmentAuthority",
          "expected": "canonical-linear-project-and-direct-issues",
          "critical": true
        },
        {
          "id": "build-linear-role",
          "kind": "final-json-path-equals",
          "pointer": "/linearRole",
          "expected": "product-scope-and-plan-authority"
        },
        {
          "id": "build-gate-order",
          "kind": "final-json-path-equals",
          "pointer": "/hardGates",
          "expected": [
            "project-spec-approval",
            "execution-plan-approval"
          ],
          "critical": true
        },
        {
          "id": "build-gate-two-pending",
          "kind": "final-json-path-equals",
          "pointer": "/buildAdvance",
          "expected": false
        },
        {
          "id": "build-bounded-route",
          "kind": "final-json-path-equals",
          "pointer": "/boundedRoute",
          "expected": "woostack-change",
          "critical": true
        },
        {
          "id": "build-bounded-no-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreatedForBoundedRoute",
          "expected": false,
          "critical": true
        },
        {
          "id": "build-routing-no-effects",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryEffects",
          "expected": []
        }
      ]
    },
    {
      "id": "fails-closed-on-project-graph-and-approval-drift",
      "prompt": "Evaluate every scenario in fixtures/graph-conflicts.json without provider, Git, or repository mutation. Preserve fixture order. Return exactly one JSON object with key results, an array whose objects have exactly id, advance, invalidatedGates, reasonCode, and repositoryEffects.",
      "fixtures": [
        "graph-conflicts.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Foreign repository association, unresolved workspace or team, duplicate direct task identity, stale project approval, stale execution-plan approval, native dependency drift, and incomplete read-back each fail closed and invalidate only the causally affected gates without repository effects.",
      "assertions": [
        {
          "id": "build-drift-results",
          "kind": "final-json-path-equals",
          "pointer": "/results",
          "expected": [
            {
              "id": "foreign-repository",
              "advance": false,
              "invalidatedGates": [
                1,
                2
              ],
              "reasonCode": "foreign-project-repository",
              "repositoryEffects": []
            },
            {
              "id": "workspace-team-mismatch",
              "advance": false,
              "invalidatedGates": [
                1,
                2
              ],
              "reasonCode": "project-workspace-team-mismatch",
              "repositoryEffects": []
            },
            {
              "id": "duplicate-current-task",
              "advance": false,
              "invalidatedGates": [
                2
              ],
              "reasonCode": "duplicate-current-task-identity",
              "repositoryEffects": []
            },
            {
              "id": "stale-project-approval",
              "advance": false,
              "invalidatedGates": [
                1,
                2
              ],
              "reasonCode": "project-spec-approval-stale",
              "repositoryEffects": []
            },
            {
              "id": "stale-plan-approval",
              "advance": false,
              "invalidatedGates": [
                2
              ],
              "reasonCode": "execution-plan-approval-stale",
              "repositoryEffects": []
            },
            {
              "id": "dependency-drift",
              "advance": false,
              "invalidatedGates": [
                2
              ],
              "reasonCode": "native-dependency-drift",
              "repositoryEffects": []
            },
            {
              "id": "incomplete-readback",
              "advance": false,
              "invalidatedGates": [
                2
              ],
              "reasonCode": "incomplete-linear-readback",
              "repositoryEffects": []
            }
          ],
          "critical": true
        }
      ]
    },
    {
      "id": "refuses-unsafe-project-replan",
      "prompt": "Apply the replan contract to fixtures/project-replan.json without provider, Git, or repository mutations. Return exactly one JSON object with keys advance, reasonCode, preservedTaskIds, approvalInvalidated, ordinalDefinesAncestry, providerMutationCount, and repositoryEffects.",
      "fixtures": [
        "project-replan.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Replanning preserves stable direct-issue identities, refuses removal of an increment carrying repository evidence, never derives ancestry from ordinals, invalidates execution-plan approval for a material graph change, and performs no mutation.",
      "assertions": [
        {
          "id": "build-replan-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/advance",
          "expected": false,
          "critical": true
        },
        {
          "id": "build-replan-reason",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "evidence-bearing-increment-removal"
