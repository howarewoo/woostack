{
  "schemaVersion": 1,
  "skill": "woostack-build",
  "cases": [
    {
      "id": "routes-approved-build-to-user-handoff",
      "prompt": "An exact canonical local run, its strict direct-issue chain, and plain Markdown project-spec.md and execution-plan.md have all been independently verified in the active process. Approved parent-branch intent is \"refs/heads/main\", fresh Git, Graphite, and GitHub evidence independently binds the last admitted parent tip as \"sha256:main-tip-17\", and run artifacts are retained under .woostack/tmp/runs/<run-id>/. Return the verified Build handoff without contacting a provider or mutating a repository. Classify Stop here, Execute, Abandon, and unknown/custom responses.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Build displays the exact verified run ID, stable task mappings, dependencies, approved parent branch, last admitted tip, optional mirror mappings and status, and /woostack-execute --run <exact-run-id>, then asks a body-free handoff with exactly Stop here, Execute, and Abandon. Stop here returns without mutation; Execute dispatches normal Execute once; Abandon records terminal status in the manifest and retains artifacts without dispatching; unknown or custom responses fail closed and ask again. Execute-era safety reads are preserved.",
      "assertions": [
        {
          "id": "handoff-options",
          "kind": "final-json-path-equals",
          "pointer": "/handoff/options",
          "expected": [
            "Stop here",
            "Execute",
            "Abandon"
          ],
          "critical": true
        },
        {
          "id": "handoff-body-free",
          "kind": "final-json-path-equals",
          "pointer": "/handoff/bodyFree",
          "expected": true,
          "critical": true
        },
        {
          "id": "handoff-command",
          "kind": "final-json-path-equals",
          "pointer": "/handoff/command",
          "expected": "/woostack-execute --run <exact-run-id>",
          "critical": true
        },
        {
          "id": "handoff-details-complete",
          "kind": "final-json-path-equals",
          "pointer": "/handoff/details",
          "expected": [
            "runId",
            "stableTaskMappings",
            "dependencies",
            "approvedParentBranch",
            "lastAdmittedTip"
          ],
          "critical": true
        },
        {
          "id": "stop-here-no-effects",
          "kind": "final-json-path-equals",
          "pointer": "/responses/Stop here/effects",
          "expected": [],
          "critical": true
        },
        {
          "id": "execute-dispatched-once",
          "kind": "final-json-path-equals",
          "pointer": "/responses/Execute/dispatchCount",
          "expected": 1,
          "critical": true
        },
        {
          "id": "abandon-retains-artifacts-without-dispatch",
          "kind": "final-json-path-equals",
          "pointer": "/responses/Abandon",
          "expected": {
            "status": "abandoned",
            "artifactsRetained": true,
            "dispatchCount": 0
          },
          "critical": true
        },
        {
          "id": "unknown-fails-closed",
          "kind": "final-json-path-equals",
          "pointer": "/responses/unknown/askAgain",
          "expected": true,
          "critical": true
        },
        {
          "id": "custom-fails-closed",
          "kind": "final-json-path-equals",
          "pointer": "/responses/custom/askAgain",
          "expected": true,
          "critical": true
        },
        {
          "id": "execute-safety-reads-unchanged",
          "kind": "final-json-path-equals",
          "pointer": "/executeSafetyReadsUnchanged",
          "expected": true,
          "critical": true
        },
        {
          "id": "never-merges",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "creates-canonical-project-before-ideation",
      "prompt": "Evaluate fixtures/project-admission.json as deliberate Linear adapter coverage for a new woostack-build invocation with no exact project when artifacts.provider: \"linear\" is selected. Do not contact a provider or mutate the repository. Validate the configured Linear repository, workspace, team, official Linear MCP preflight, native-operation preference, fallback UUID and exact summary marker, complete active and archived absence proof, prefixed project name, one create, same-marker recovery rules, and independent native-project-ID read-back. Return exactly one JSON object with keys status, provider, officialMcpVerified, projectCreated, projectId, projectName, operationIdentityPreserved, independentReadBackVerified, summaryMarkerPreserved, fallbackRecovery, nextStep, and repositoryMutationCount.",
