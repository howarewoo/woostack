          "pointer": "/workspaceTeamVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "project",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": "project-build-42",
          "critical": true
        },
        {
          "id": "project-not-recreated",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "complete-pre-mutation-hierarchy-read",
