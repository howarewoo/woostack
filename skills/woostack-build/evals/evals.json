  "cases": [
    {
      "id": "routes-selected-hardened-build-to-overnight-with-exact-context",
      "prompt": "Evaluate fixtures/build-state.json selectedOvernight after the execution handoff choice. Do not mutate anything. Return exactly one JSON object using the keys status, artifactModeSelected, canonicalRepositoryVerified, workspaceTeamVerified, projectId, projectCreated, preMutationHierarchyReadComplete, persistenceChronologyVerified, parentPlanIssueId, incrementChildIssueIds, mutationClientIds, approvedProjectContextReadBackVerified, hierarchyReadBackVerified, providerPersistencePasses, hardGates, terminalChoice, executionSkill, executionArtifactContext, and mergeAllowed.",
      "fixtures": [
        "build-state.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The caller-selected existing project was reconciled once after graph hardening without replacement creation; provider preflight and complete pre-mutation hierarchy reads preceded all writes, and the approved specification context and complete hierarchy were independently read back. Exactly three gates remain, Run overnight routes the same approved plan plus exact project/parent/children context to woostack-execute-overnight, and merge remains forbidden.",
      "assertions": [
        {
          "id": "ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "selected",
          "kind": "final-json-path-equals",
          "pointer": "/artifactModeSelected",
          "expected": true,
          "critical": true
        },
        {
