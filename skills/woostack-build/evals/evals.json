    {
      "id": "records-nonblocking-provider-boundaries",
      "prompt": "Classify every scenario in fixtures/provider-boundaries.json across local, Linear, and Plane provider selections when local Build artifacts are written, without contacting a provider or mutating the repository. Treat summary flags as untrusted. Return exactly one JSON object with keys status, mirrorStatus, localAuthorityValid, executeHandoffAllowed, decisions, providerMutationCount, and repositoryMutationCount. Each decision must contain exactly id, advance, and reasonCode in fixture order. Here executeHandoffAllowed refers only to presenting retained artifacts for caller-selected bounded execution, not automatic run dispatch.",
      "fixtures": [
        "provider-boundaries.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Build completes local planning with valid local authority and allows Execute handoff. Provider boundary failures record mirrorStatus failed without invalidating local authority or mutating the repository.",
      "assertions": [
        {
          "id": "build-local-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "build-mirror-failed",
          "kind": "final-json-path-equals",
          "pointer": "/mirrorStatus",
          "expected": "failed",
          "critical": true
        },
        {
          "id": "build-local-authority-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/localAuthorityValid",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-handoff-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/executeHandoffAllowed",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-provider-decisions",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": [
            {
              "id": "local-disabled",
              "advance": true,
              "reasonCode": "mirror-disabled-local-authority"
            },
            {
              "id": "linear-mcp-unavailable",
              "advance": true,
              "reasonCode": "mirror-official-linear-mcp-unavailable"
            },
            {
              "id": "linear-authentication-unavailable",
              "advance": true,
              "reasonCode": "mirror-authentication-unavailable"
            },
            {
              "id": "linear-incomplete-pagination",
              "advance": true,
              "reasonCode": "mirror-pagination-incomplete"
            },
            {
              "id": "linear-readback-mismatch",
              "advance": true,
              "reasonCode": "mirror-readback-mismatch"
            },
            {
              "id": "plane-label-capability-missing",
              "advance": true,
              "reasonCode": "mirror-plane-label-capability-missing"
            },
            {
              "id": "plane-duplicate-external-id-pair",
              "advance": true,
              "reasonCode": "mirror-plane-duplicate-external-id-pair"
            },
            {
              "id": "plane-pagination-incomplete",
              "advance": true,
              "reasonCode": "mirror-plane-pagination-incomplete"
            },
            {
              "id": "plane-readback-mismatch",
              "advance": true,
              "reasonCode": "mirror-plane-readback-mismatch"
            }
          ],
          "critical": true
        },
        {
          "id": "build-provider-zero-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/providerMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "build-provider-zero-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        }
