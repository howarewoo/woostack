        {
          "id": "build-replan-identities",
          "kind": "final-json-path-equals",
          "pointer": "/preservedTaskIds",
          "expected": [
            "storage",
            "api"
          ]
        },
        {
          "id": "build-replan-invalidates-plan-approval",
          "kind": "final-json-path-equals",
          "pointer": "/approvalInvalidated",
          "expected": "execution-plan-approval",
          "critical": true
        },
        {
          "id": "build-replan-ordinal-not-ancestry",
          "kind": "final-json-path-equals",
          "pointer": "/ordinalDefinesAncestry",
          "expected": false
        },
        {
          "id": "build-replan-no-provider-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/providerMutationCount",
          "expected": 0
        },
        {
          "id": "build-replan-no-repository-effects",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryEffects",
          "expected": []
        }
      ]
    }
  ]
}
