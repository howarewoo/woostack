    {
      "id": "rejects-noncanonical-build-authority",
      "prompt": "Use fixtures/authority-inputs.json only as supplied evidence, without commands or remote access. For each scenario, can Build claim that its planning run and retained-artifact handoff are complete? Explain the missing evidence and whether that conclusion imposes a retained-run requirement on a separate complete bounded Execute input.",
      "fixtures": [
        "authority-inputs.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Build cannot claim completion without its retained local planning artifacts, and provider documents never authorize work. This Build retention requirement does not make a run manifest mandatory for an independently supplied bounded Execute task.",
      "assertions": [
        {
          "id": "build-authority-boundary",
          "kind": "qualitative",
          "rubric": "Does the response reject completion claims in all three Build scenarios, preserve user authority versus artifact evidence, and distinguish Build retained planning records from Execute admission of a complete bounded input without a run?",
          "critical": true
        }
      ]
    },
    {
      "id": "retains-local-run-artifacts",
      "prompt": "Reason without commands or mutation. Build has written and independently verified its local specification and execution plan; optional mirror synchronization failed. The user chooses Execute but supplies only the run ID. Explain artifact retention, whether mirroring blocks local completion, and the next execution input.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Retains the completed local planning artifacts despite mirror failure, does not dispatch obsolete --run execution, and asks the caller to select and supply one complete bounded task.",
      "assertions": [
        {
          "id": "retention-and-bounded-handoff",
          "kind": "qualitative",
          "rubric": "Does the response retain all run artifacts with mirror failure nonblocking, stop automatic run execution, and require caller selection of one complete bounded task rather than dispatching or deleting artifacts?",
          "critical": true
        }
      ]
    },
