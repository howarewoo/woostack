{
  "schemaVersion": 1,
  "skill": "woostack-build",
  "cases": [
    {
      "id": "verified-artifact-handoff",
      "prompt": "Reason from this snapshot without commands or mutation. Build has completed and independently verified its retained specification, execution plan, task mappings, dependency tuples, planning parent and tip. Classify the user replies Stop here, Execute, Abandon, an ambiguous maybe later, and a request to replace the agreed database. No individual bounded task has yet been selected for execution. Explain the retained-artifact handoff and any automatic dispatch.",
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Build stops at retained artifacts, explains retired run execution, and requires caller selection of one complete bounded task. Stop preserves state; Abandon records abandonment but retains artifacts; ambiguous or changed decisions return to their proper decision boundary.",
      "assertions": [
        {
          "id": "handoff-retirement-note",
          "kind": "qualitative",
          "rubric": "Does Build present retained artifact/task/parent evidence, explain that --run is retired, and require a caller-selected complete bounded task with no automatic dispatch, while preserving Stop/Abandon retention and clarification of ambiguous or changed-scope choices?",
          "critical": true
        },
        {
          "id": "never-merges",
          "kind": "qualitative",
          "rubric": "Does the response keep repository delivery and any merge advancement outside this planning handoff and avoid implying that Execute or Abandon grants merge authority?",
          "critical": true
        }
      ]
    },
    {
      "id": "creates-canonical-project-before-ideation",
      "prompt": "Evaluate fixtures/project-admission.json as deliberate Linear adapter coverage for a new woostack-build invocation with no exact project when artifacts.provider: \"linear\" is selected. Do not contact a provider or mutate the repository. Validate the configured Linear repository, workspace, team, official Linear MCP preflight, native-operation preference, fallback UUID and exact summary marker, complete active and archived absence proof, prefixed project name, one create, same-marker recovery rules, and independent native-project-ID read-back. Return exactly one JSON object with keys status, provider, officialMcpVerified, projectCreated, projectId, projectName, operationIdentityPreserved, independentReadBackVerified, summaryMarkerPreserved, fallbackRecovery, nextStep, and repositoryMutationCount.",
      "fixtures": [
        "project-admission.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Build validates all Linear pre-ideation requirements, performs zero fallback discovery when native operation identity is supported, and falls back to complete active/archived absence proof plus an exact summary marker only when native identity is unsupported. Recovery rules fail closed on pagination, duplicate, foreign, drifted, replacement-UUID, and create-replay outcomes. Once admitted, the next step is ideate with zero repository mutations.",
      "assertions": [
        {
          "id": "build-project-admission-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "build-linear-provider-selected",
          "kind": "final-json-path-equals",
          "pointer": "/provider",
          "expected": "linear",
          "critical": true
        },
        {
          "id": "build-official-mcp",
          "kind": "final-json-path-equals",
          "pointer": "/officialMcpVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-project-created",
          "kind": "final-json-path-equals",
          "pointer": "/projectCreated",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-created-project-id",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": "project-build-43",
          "critical": true
        },
        {
          "id": "build-created-project-name",
          "kind": "final-json-path-equals",
          "pointer": "/projectName",
          "expected": "[Build] Bound cache freshness",
          "critical": true
        },
        {
          "id": "build-operation-identity-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/operationIdentityPreserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-project-readback",
          "kind": "final-json-path-equals",
          "pointer": "/independentReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-project-marker-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/summaryMarkerPreserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "build-project-fallback-recovery-fails-closed",
          "kind": "final-json-path-equals",
          "pointer": "/fallbackRecovery",
          "expected": [
            {
              "id": "partial-pagination",
              "advance": false,
              "reasonCode": "incomplete-project-pagination",
              "createAttempts": 0,
              "replacementIdentityAllocated": false,
              "createReplay": false
            },
            {
              "id": "duplicate-marker",
              "advance": false,
              "reasonCode": "duplicate-project-mutation-marker",
              "createAttempts": 0,
              "replacementIdentityAllocated": false,
              "createReplay": false
            },
            {
              "id": "foreign-marker",
              "advance": false,
              "reasonCode": "foreign-project-mutation-marker",
              "createAttempts": 0,
              "replacementIdentityAllocated": false,
              "createReplay": false
            },
            {
              "id": "malformed-marker",
