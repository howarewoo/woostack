{
  "schemaVersion": 1,
  "skill": "woostack-init",
  "cases": [
    {
      "id": "repairs-linear-workspace-without-local-development-records",
      "prompt": "Initialize the synthetic project at fixtures/project using the packaged woostack-init procedure in --no-clobber mode. Work only inside fixtures/project. Treat the existing non-secret Linear policy and the host-provided successful official Linear MCP capability receipt as verified preflight input. Preserve .woostack/config.json byte-for-byte, create only the remaining canonical knowledge, response, worktree, and diagnostic pieces, never create specs, plans, or fixes, run build-index, then run `bash fixtures/tools/doctor.sh fixtures/project`. Return exactly one JSON object with keys mode, createdPaths, skippedPaths, validationOrder, doctorExitCode, configBeforeSha256, and configAfterSha256.",
      "fixtures": [
        "project/.woostack/config.json",
        "project/.woostack/existing-note.txt",
        "tools/doctor.sh"
      ],
      "capabilities": ["read-workspace", "write-workspace", "shell-workspace"],
      "expected": "Verified Linear preflight precedes project-file writes; no-clobber preserves config and existing files, creates only non-authoritative workspace pieces, runs build-index before doctor, and creates no local development records or secrets.",
      "assertions": [
        {"id":"memory-index-created","kind":"path-exists","path":"fixtures/project/.woostack/memory/MEMORY.md"},
        {"id":"wisdom-marker-created","kind":"path-exists","path":"fixtures/project/.woostack/wisdom/.gitkeep"},
        {"id":"respond-directory-materialized","kind":"path-exists","path":"fixtures/project/.woostack/respond/.gitkeep"},
        {"id":"gitignore-created","kind":"path-exists","path":"fixtures/project/.woostack/.gitignore"},
        {
          "id":"complete-config-object-preserved",
          "kind":"json-path-equals",
          "file":"fixtures/project/.woostack/config.json",
          "pointer":"",
          "expected": {
            "linear": {
              "repository":"https://github.com/acme/widgets",
              "workspace":"acme",
              "team":"ENG",
              "projectStatuses": {
                "designApproved":"Backlog","specHardened":"Backlog","specApproved":"Backlog","planning":"Backlog","ready":"Planned","executionApproved":"Planned","executing":"Started","inReview":"Started","done":"Completed","abandoned":"Canceled","paused":"Paused"
              },
              "issueStates": {"planned":"Backlog","executing":"In Progress","inReview":"In Review","done":"Done","blocked":"Blocked"}
            },
            "models":{},"review":{},"respond":{},"status":{"staleDays":14},"owner":"platform"
          },
          "critical":true
        },
        {"id":"no-backend-selector","kind":"file-excludes","file":"fixtures/project/.woostack/config.json","substring":"specPlan","critical":true},
        {"id":"no-linear-secret-invented","kind":"file-excludes","file":"fixtures/project/.woostack/config.json","substring":"LINEAR_API_KEY","critical":true},
        {"id":"existing-file-preserved","kind":"file-contains","file":"fixtures/project/.woostack/existing-note.txt","substring":"user-owned sentinel","critical":true},
        {"id":"no-clobber-mode-reported","kind":"final-json-path-equals","pointer":"/mode","expected":"no-clobber","critical":true},
        {"id":"linear-preflight-before-writes","kind":"qualitative","rubric":"Does the response prove official Linear MCP capability preflight completed before any project-file write and that specs/plans/fixes were not created?","critical":true},
        {"id":"validation-order","kind":"qualitative","rubric":"Does the response evidence show build-index ran before doctor?","critical":true},
        {"id":"doctor-validation-succeeded","kind":"final-json-path-equals","pointer":"/doctorExitCode","expected":0,"critical":true},
        {"id":"config-before-hash","kind":"final-json-path-equals","pointer":"/configBeforeSha256","expected":"f0fb118761a73b3c38b808cefab750b128d31b8568f2aa7884e9ce81ef776f1e","critical":true},
        {"id":"config-after-hash","kind":"final-json-path-equals","pointer":"/configAfterSha256","expected":"f0fb118761a73b3c38b808cefab750b128d31b8568f2aa7884e9ce81ef776f1e","critical":true}
      ]
    }
  ]
}
