{
  "schemaVersion": 1,
  "skill": "woostack-address-comments",
  "cases": [
    {
      "id": "default-flow-stops-at-verdict-gate",
      "prompt": "Analyze the bounded unresolved threads in fixtures/address-pending.json under the default /woostack-address-comments flow as a synthetic receipt exercise. Do not call GitHub, Git, Linear, or mutate files. Facts: canonical PR #42 has the sole final trailer `Linear-Issue: APP-42`; official-MCP independent reads verify managed work-item client UUID 11111111-1111-4111-8111-111111111111, no project membership, human owner user-7, matching current assignmentAccepted, and a current reviewResult whose head/diff/thread IDs equal the fixture. Return exactly one JSON object using keys status, recommendationsComplete, gateState, issueClientId, projectId, ownerVerified, assignmentVerified, findingReceiptVerified, linearMutationCount, editsApplied, pushed, repliesPosted, threadsResolved, memoryWritten, and mergeAllowed. Use booleans for completion and side-effect fields, status `awaiting-verdict-approval`, and gateState `pending-explicit-approval`.",
      "fixtures": [
        "address-pending.json",
        "repo/src/cache.ts"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Exact attribution, projectless role, type-aware owner/current assignment, and typed finding receipt are verified before recommendations; then the default flow stops at the explicit verdict gate with no Linear event, edit, push, reply, resolution, memory write, or merge.",
      "assertions": [
        {
          "id": "all-thread-recommendations-complete",
          "kind": "final-json-path-equals",
          "pointer": "/recommendationsComplete",
          "expected": true,
          "critical": true
        },
        {
          "id": "verdict-gate-pending",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "awaiting-verdict-approval",
          "critical": true
        },
        {
          "id": "gate-not-inferred",
          "kind": "final-json-path-equals",
          "pointer": "/gateState",
          "expected": "pending-explicit-approval",
          "critical": true
        },
        {
          "id": "no-edits-before-gate",
          "kind": "final-json-path-equals",
          "pointer": "/editsApplied",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-push-before-gate",
          "kind": "final-json-path-equals",
          "pointer": "/pushed",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-replies-before-gate",
          "kind": "final-json-path-equals",
          "pointer": "/repliesPosted",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-resolves-before-gate",
          "kind": "final-json-path-equals",
          "pointer": "/threadsResolved",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-memory-before-gate",
          "kind": "final-json-path-equals",
          "pointer": "/memoryWritten",
          "expected": false,
          "critical": true
        },
        {
          "id": "source-unchanged-before-gate",
          "kind": "file-contains",
          "file": "fixtures/repo/src/cache.ts",
          "substring": "return store.get(key);",
          "critical": true
        },
        {
          "id": "address-never-merges-at-gate",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        },
        {
          "id": "exact-issue-context-retained",
          "kind": "final-json-path-equals",
          "pointer": "/issueClientId",
          "expected": "11111111-1111-4111-8111-111111111111",
          "critical": true
        },
        {
          "id": "work-item-project-is-absent",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": null,
          "critical": true
        },
        {
          "id": "type-aware-owner-verified",
          "kind": "final-json-path-equals",
          "pointer": "/ownerVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "current-assignment-verified",
          "kind": "final-json-path-equals",
          "pointer": "/assignmentVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "typed-finding-receipt-verified",
          "kind": "final-json-path-equals",
          "pointer": "/findingReceiptVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-linear-event-before-gate",
          "kind": "final-json-path-equals",
          "pointer": "/linearMutationCount",
          "expected": 0,
          "critical": true
        }
      ]
    },
    {
      "id": "approved-verdicts-require-push-receipt-before-thread-close",
