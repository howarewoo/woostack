          "critical": true
        },
        {
          "id": "fix-outcome-recorded",
          "kind": "final-json-path-equals",
          "pointer": "/finalOutcomes/T1",
          "expected": "fixed",
          "critical": true
        },
        {
          "id": "pushback-outcome-recorded",
          "kind": "final-json-path-equals",
          "pointer": "/finalOutcomes/T2",
          "expected": "pushed-back",
          "critical": true
        },
        {
          "id": "push-completed",
          "kind": "final-json-path-equals",
          "pointer": "/pushed",
          "expected": true,
          "critical": true
        },
        {
          "id": "push-receipt-gates-closeout",
          "kind": "final-json-path-equals",
          "pointer": "/pushReceiptVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "closeout-after-push-receipt",
          "kind": "final-json-path-equals",
          "pointer": "/closeoutAfterPushReceipt",
          "expected": true,
          "critical": true
        },
        {
          "id": "all-replies-posted",
          "kind": "final-json-path-equals",
          "pointer": "/repliesPosted",
          "expected": [
            "T1",
            "T2"
          ],
          "critical": true
        },
        {
          "id": "all-handled-threads-resolved",
          "kind": "final-json-path-equals",
          "pointer": "/threadsResolved",
          "expected": [
            "T1",
            "T2"
          ],
          "critical": true
        },
        {
          "id": "rereview-offered",
          "kind": "final-json-path-equals",
          "pointer": "/offeredRereview",
          "expected": true,
          "critical": true
        },
        {
          "id": "address-never-merges-after-closeout",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        },
        {
          "id": "increment-issue-id-carried",
          "kind": "final-json-path-equals",
          "pointer": "/issueClientId",
          "expected": "22222222-2222-4222-8222-222222222222",
          "critical": true
        },
        {
          "id": "feature-project-id-carried",
          "kind": "final-json-path-equals",
          "pointer": "/projectClientId",
          "expected": "33333333-3333-4333-8333-333333333333",
          "critical": true
        },
        {
          "id": "app-owner-field-is-delegate",
          "kind": "final-json-path-equals",
