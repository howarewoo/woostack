        "address-approved.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The exact increment/project attribution and app owner resolved from the delegate field plus current assignment remain verified; typed finding and FIX-resolution events have independent read-backs; the exact-context commit/re-review handoff is retained; a verified pushed commit precedes replies/resolutions; re-review is offered and no merge occurs.",
      "assertions": [
        {
          "id": "approved-verdict-batch-verified",
          "kind": "final-json-path-equals",
          "pointer": "/approvalVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "every-thread-handled",
