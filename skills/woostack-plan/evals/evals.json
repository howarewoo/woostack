            "build-desired-issue-graph",
            "append-planning",
            "read-planning-event",
            "read-project-planning-head",
            "create-increment:10000000-0000-4000-8000-000000000021",
            "read-increment:issue-cache-71",
            "create-increment:10000000-0000-4000-8000-000000000022",
            "read-increment:issue-cache-72",
            "read-existing-relations",
            "create-relation:issue-cache-72->issue-cache-71",
            "read-relation:issue-cache-72->issue-cache-71",
            "read-final-relations",
            "read-final-project-graph"
          ],
          "critical": true
        },
        {
          "id": "plan-complete-increment-graph",
          "kind": "final-json-path-equals",
          "pointer": "/issueGraph",
          "expected": [
            {
              "clientId": "10000000-0000-4000-8000-000000000021",
              "nativeId": "issue-cache-71",
              "ordinal": 1,
              "projectId": "project-cache-7",
              "dependencyNativeIds": [],
              "objective": "Refresh one expired cache value while retaining the fresh-value fast path.",
              "contractComplete": true,
              "readBackVerified": true
            },
            {
              "clientId": "10000000-0000-4000-8000-000000000022",
              "nativeId": "issue-cache-72",
              "ordinal": 2,
              "projectId": "project-cache-7",
              "dependencyNativeIds": [
                "issue-cache-71"
              ],
              "objective": "Coalesce concurrent refreshes for one expired cache key.",
              "contractComplete": true,
              "readBackVerified": true
