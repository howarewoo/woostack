  "cases": [
    {
      "id": "reconciles-stable-increment-children-with-native-dependencies",
      "prompt": "Reconcile a caller-selected exact Linear project whose desired parent plan issue contains two increment children: stable task storage ordinal 20 with no predecessor and stable task api ordinal 10 depending on storage. Existing native child IDs are issue-1 and issue-2, and independent read-back matches every child, parent-child link, and native blocked-by relation. Do not mutate anything. Return exactly one JSON object with keys status, parentPlanIssueCount, childIssueCount, preservedTaskIds, nativeBlockedBy, ordinalDefinesAncestry, repositoryEffects, and hierarchyReadBackVerified.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "One parent plan issue, two stable increment children, and the direct native dependency reconcile successfully; ordinals do not imply ancestry and all hierarchy edges are read back.",
      "assertions": [
        {
          "id": "ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "one-parent",
          "kind": "final-json-path-equals",
          "pointer": "/parentPlanIssueCount",
          "expected": 1,
          "critical": true
        },
        {
          "id": "two-children",
          "kind": "final-json-path-equals",
          "pointer": "/childIssueCount",
          "expected": 2,
          "critical": true
        },
        {
          "id": "stable-tasks",
          "kind": "final-json-path-equals",
          "pointer": "/preservedTaskIds",
          "expected": [
            "storage",
            "api"
          ],
          "critical": true
        },
        {
          "id": "native-dependency",
          "kind": "final-json-path-equals",
          "pointer": "/nativeBlockedBy",
          "expected": {
            "api": [
              "issue-1"
            ],
            "storage": []
          },
          "critical": true
        },
        {
          "id": "ordinal-not-ancestry",
          "kind": "final-json-path-equals",
          "pointer": "/ordinalDefinesAncestry",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-repository-effects",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryEffects",
          "expected": [],
          "critical": true
        },
        {
          "id": "hierarchy-readback",
          "kind": "final-json-path-equals",
          "pointer": "/hierarchyReadBackVerified",
          "expected": true,
          "critical": true
        }
      ]
    },
