          "id": "replan-blocks",
          "kind": "final-json-path-equals",
          "pointer": "/advance",
          "expected": false,
          "critical": true
        },
        {
          "id": "replan-reason",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "evidence-bearing-issue-removal-refused",
          "critical": true
