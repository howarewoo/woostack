          "kind": "final-json-path-equals",
          "pointer": "/project",
          "expected": {
            "clientId": "10000000-0000-4000-8000-000000000001",
            "nativeId": "project-cache-7",
            "repository": "https://github.com/acme/cache-service",
            "role": "feature"
          },
          "critical": true
        },
        {
          "id": "plan-current-approved-head",
          "kind": "final-json-path-equals",
          "pointer": "/initialPhaseHead",
