            "10000000-0000-4000-8000-000000000002"
          ],
          "critical": true
        },
        {
          "id": "replan-no-repository-effects",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryEffects",
          "expected": [],
          "critical": true
        },
        {
          "id": "replan-read-back",
          "kind": "final-json-path-equals",
          "pointer": "/readBackVerified",
          "expected": true,
          "critical": true
        }
      ]
    },
    {
      "id": "enters-planning-before-reconciling-increments",
