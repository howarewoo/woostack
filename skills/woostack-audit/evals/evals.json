{
  "schemaVersion": 1,
  "skill": "woostack-audit",
  "cases": [
    {
      "id": "audits-standing-file-through-all-added-report-only-path",
      "prompt": "Run a bounded offline report-only audit of the standing target fixtures/repo/src/cache.js. Do not call a provider, network, GitHub, or Linear, and do not edit the target. Treat fixtures/review/receipts.json and fixtures/review/findings.json as host-produced synthetic swarm evidence. Build an all-added diff at audit-out/diff.txt, verify every expected synthetic angle receipt, and render the ranked report at the fixed date/path .woostack/audits/2026-07-16-cache-js.md. The report must open with `Non-authoritative diagnostic evidence — report only`, visibly state `Authority: non-authoritative diagnostic evidence`, record the receipt IDs and validated finding, and include a `Proposed managed issue contract` with repository, proved problem, bounded scope, evidence, and observable acceptance criteria while stating that it is not scope or acceptance authority. Do not bind, create, or mutate an issue, dispatch remediation, write a local spec/plan/fix handoff, or change source. Return only the report path.",
      "fixtures": [
        "repo/src/cache.js",
        "review/receipts.json",
        "review/findings.json"
      ],
      "capabilities": [
        "read-workspace",
        "write-workspace"
      ],
      "expected": "The standing target becomes an all-added diff; all expected receipts and the validated finding appear in a sanitized local report labeled non-authoritative with a proposed managed issue contract; the report never becomes development authority; the target, Linear, local development records, posting, remediation, and merge remain untouched.",
      "assertions": [
        {
          "id": "all-added-diff-created",
          "kind": "path-exists",
          "path": "audit-out/diff.txt"
        },
        {
          "id": "all-added-line-present",
          "kind": "file-contains",
          "file": "audit-out/diff.txt",
          "substring": "+export function put(cache, key, value)"
        },
        {
          "id": "audit-report-created",
          "kind": "path-exists",
          "path": ".woostack/audits/2026-07-16-cache-js.md"
        },
        {
          "id": "standing-code-method-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "all-added diff"
        },
        {
          "id": "simplify-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-simplify-cache",
          "critical": true
        },
        {
          "id": "bugs-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-bugs-cache",
          "critical": true
        },
        {
          "id": "security-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-security-cache",
          "critical": true
        },
        {
          "id": "production-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-production-cache",
          "critical": true
        },
        {
          "id": "validated-finding-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Unbounded cache growth"
        },
        {
          "id": "report-is-explicitly-non-authoritative",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Non-authoritative diagnostic evidence",
          "critical": true
        },
        {
          "id": "diagnostic-authority-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Authority: non-authoritative diagnostic evidence",
          "critical": true
        },
        {
          "id": "proposed-managed-issue-contract-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Proposed managed issue contract",
          "critical": true
        },
        {
          "id": "report-denies-development-authority",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "not scope or acceptance authority",
          "critical": true
        },
        {
          "id": "standing-target-unchanged",
          "kind": "file-sha256-equals",
          "file": "fixtures/repo/src/cache.js",
          "sha256": "sha256:564515d609ff8c08c2557a4e54f88184779e06ef2e93bf9729683aec467b4227",
          "critical": true
        },
        {
          "id": "no-code-host-post",
          "kind": "path-absent",
          "path": "audit-out/code-host-post.json",
          "critical": true
        },
        {
          "id": "no-linear-mutation-receipt",
          "kind": "path-absent",
          "path": "audit-out/linear-mutation.json",
          "critical": true
        },
        {
          "id": "no-audit-fix",
          "kind": "path-absent",
          "path": "fixtures/repo/src/cache.fixed.js",
          "critical": true
        },
        {
          "id": "no-local-fix-authority",
          "kind": "path-absent",
          "path": ".woostack/fixes",
          "critical": true
        },
        {
          "id": "no-audit-merge",
          "kind": "path-absent",
          "path": "audit-out/merge.json",
          "critical": true
        }
      ]
    },
    {
      "id": "rejects-remediation-without-exact-managed-issue",
      "prompt": "Classify this bounded audit follow-up without calling a provider, network, GitHub, Git, or Linear and without modifying files. Facts: the sanitized audit report is valid but explicitly non-authoritative; it proposes one work-item contract; the user asks to implement it now; no exact managed issue has been bound; official host-exposed Linear MCP bind/create plus independent read-back capability is unavailable. Return exactly one JSON object with keys status, reasonCode, reportAuthority, linearMutationCount, repositoryMutationCount, fixDispatched, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Remediation is blocked because a local report/proposal cannot substitute for one exact verified managed issue; no Linear/repository mutation, fix dispatch, or local development artifact occurs.",
      "assertions": [
        {
          "id": "remediation-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "exact-issue-required",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "exact-managed-issue-required",
          "critical": true
        },
        {
          "id": "report-remains-evidence",
          "kind": "final-json-path-equals",
          "pointer": "/reportAuthority",
          "expected": "non-authoritative",
          "critical": true
        },
        {
          "id": "no-linear-mutation-on-rejection",
          "kind": "final-json-path-equals",
          "pointer": "/linearMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "no-repository-mutation-on-rejection",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "no-fix-dispatch",
          "kind": "final-json-path-equals",
          "pointer": "/fixDispatched",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-local-development-fallback",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    }
  ]
}
