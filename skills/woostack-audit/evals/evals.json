{
  "schemaVersion": 1,
  "skill": "woostack-audit",
  "cases": [
    {
      "id": "audits-standing-file-through-all-added-report-only-path",
      "prompt": "Run a bounded offline report-only audit of the standing target fixtures/repo/src/cache.js. Do not call a provider, network, GitHub, or Linear, and do not edit the target. Treat fixtures/review/receipts.json and fixtures/review/findings.json as host-produced synthetic swarm evidence. Build an all-added diff at audit-out/diff.txt, verify every expected synthetic angle receipt, and render the ranked report at the fixed date/path .woostack/audits/2026-07-16-cache-js.md. The report must open with `Non-authoritative diagnostic evidence — report only`, visibly state `Authority: non-authoritative diagnostic evidence`, record the receipt IDs and validated finding, and include a `Proposed bounded remediation contract` with repository, proved problem, bounded scope, evidence, and acceptance criteria. Do not create or bind an issue, mutate Linear, edit the target, write `.woostack/fixes/`, post to a code host, dispatch remediation, or merge.",
      "fixtures": [
        "repo/src/cache.js",
        "review/receipts.json",
        "review/findings.json"
      ],
      "capabilities": [
        "read-workspace",
        "write-workspace"
      ],
      "expected": "The standing target becomes an all-added diff; all expected receipts and the validated finding appear in a sanitized local report labeled non-authoritative with a proposed bounded remediation contract; the report never becomes development authority; the target, Linear, local development records, posting, remediation, and merge remain untouched.",
      "assertions": [
        {
          "id": "all-added-diff-created",
          "kind": "path-exists",
          "path": "audit-out/diff.txt"
        },
        {
          "id": "all-added-line-present",
          "kind": "file-contains",
          "file": "audit-out/diff.txt",
          "substring": "+export function put(cache, key, value)"
        },
        {
          "id": "audit-report-created",
          "kind": "path-exists",
          "path": ".woostack/audits/2026-07-16-cache-js.md"
        },
        {
          "id": "standing-code-method-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "all-added diff"
        },
        {
          "id": "simplify-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-simplify-cache",
          "critical": true
        },
        {
          "id": "bugs-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-bugs-cache",
          "critical": true
        },
        {
          "id": "security-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-security-cache",
          "critical": true
        },
        {
          "id": "production-receipt-proof-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "receipt-production-cache",
          "critical": true
        },
        {
          "id": "validated-finding-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Unbounded cache growth"
        },
        {
          "id": "report-is-explicitly-non-authoritative",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Non-authoritative diagnostic evidence",
          "critical": true
        },
        {
          "id": "diagnostic-authority-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Authority: non-authoritative diagnostic evidence",
          "critical": true
        },
        {
          "id": "proposed-remediation-contract-recorded",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "Proposed bounded remediation contract",
          "critical": true
        },
        {
          "id": "report-denies-development-authority",
          "kind": "file-contains",
          "file": ".woostack/audits/2026-07-16-cache-js.md",
          "substring": "not scope or acceptance authority",
          "critical": true
        },
        {
          "id": "standing-target-unchanged",
          "kind": "file-sha256-equals",
          "file": "fixtures/repo/src/cache.js",
          "sha256": "sha256:564515d609ff8c08c2557a4e54f88184779e06ef2e93bf9729683aec467b4227",
          "critical": true
        },
        {
          "id": "no-code-host-post",
          "kind": "path-absent",
          "path": "audit-out/code-host-post.json",
          "critical": true
        },
        {
          "id": "no-linear-mutation-receipt",
          "kind": "path-absent",
          "path": "audit-out/linear-mutation.json",
          "critical": true
        },
        {
          "id": "no-audit-fix",
          "kind": "path-absent",
          "path": "fixtures/repo/src/cache.fixed.js",
          "critical": true
        },
        {
          "id": "no-local-fix-authority",
          "kind": "path-absent",
          "path": ".woostack/fixes",
          "critical": true
        },
        {
          "id": "no-audit-merge",
          "kind": "path-absent",
          "path": "audit-out/merge.json",
          "critical": true
        }
      ]
    },
    {
      "id": "routes-remediation-to-fix-diagnosis",
      "prompt": "Classify this bounded audit follow-up without calling a provider, network, GitHub, Git, or Linear and without modifying files. Facts: the sanitized audit report is valid but explicitly non-authoritative; it proposes one bounded remediation contract; the user asks to implement it now; no Linear issue was supplied and Linear MCP is unavailable. Return exactly one JSON object with keys status, reasonCode, reportAuthority, linearMutationCount, repositoryMutationCount, fixDispatched, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The report remains non-authoritative evidence and routes to woostack-fix read-only diagnosis without a Linear call at this classification boundary. After root-cause proof, fix must bind or create its canonical issue and obtain native issue approval before repository execution. No Linear or repository mutation and no local development artifact occurs during this classification.",
      "assertions": [
        {
          "id": "fix-handoff-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "fix-handoff-ready",
          "critical": true
        },
        {
          "id": "linear-deferred-until-fix-proof",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "linear-deferred-until-fix-root-cause-proof",
          "critical": true
        },
        {
          "id": "report-remains-evidence",
          "kind": "final-json-path-equals",
          "pointer": "/reportAuthority",
          "expected": "non-authoritative",
          "critical": true
        },
        {
          "id": "no-linear-mutation-on-rejection",
          "kind": "final-json-path-equals",
          "pointer": "/linearMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "no-repository-mutation-on-rejection",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "fix-dispatched",
          "kind": "final-json-path-equals",
          "pointer": "/fixDispatched",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-local-development-fallback",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    }
  ]
}
