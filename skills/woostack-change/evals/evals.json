    {
      "id": "artifact-free-change-reviews-complete-uncommitted-diff",
      "prompt": "Evaluate fixtures/change-contract-d.json at implementation handback. Do not mutate files or Git. Return exactly one JSON object using the keys status, linearCallCount, completeDiffRead, verificationObserved, specificationReview, qualityReview, commitAuthorized, and mergeAllowed.",
      "fixtures": [
        "change-contract-d.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The controller reads the complete uncommitted diff and observed checks, then performs specification and quality review before withholding commit until both pass.",
