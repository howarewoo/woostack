          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "artifact-free",
          "kind": "final-json-path-equals",
          "pointer": "/artifactMode",
          "expected": "off",
          "critical": true
        },
        {
          "id": "no-linear",
          "kind": "final-json-path-equals",
          "pointer": "/linearCallCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "resume",
          "kind": "final-json-path-equals",
          "pointer": "/worktreeAction",
          "expected": "resume",
          "critical": true
        },
        {
          "id": "exact-task",
          "kind": "final-json-path-equals",
          "pointer": "/exactTaskRecovered",
          "expected": true,
          "critical": true
        },
        {
          "id": "head",
          "kind": "final-json-path-equals",
          "pointer": "/headVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-duplicate",
          "kind": "final-json-path-equals",
          "pointer": "/duplicateWorktreeCreated",
          "expected": false,
          "critical": true
        },
        {
          "id": "never-merge",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "artifact-free-change-delegates-bounded-execution",
