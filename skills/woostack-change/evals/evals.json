      "fixtures": [
        "change-contract-f.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "One submitted PR is independently read back at its exact head/base, reviewed cleanly, and handed back without Linear or merge.",
      "assertions": [
