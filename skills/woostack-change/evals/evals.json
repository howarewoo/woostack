{
  "schemaVersion": 1,
  "skill": "woostack-change",
  "cases": [
    {
      "id": "artifact-free-change-preflights-one-clean-worktree",
      "prompt": "Evaluate fixtures/change-contract-a.json at admission. Do not mutate Git or files. Return exactly one JSON object using the keys status, artifactMode, linearCallCount, canonicalRepositoryVerified, baseVerified, collisionFree, worktreeAction, executionDelegated, and mergeAllowed.",
      "fixtures": [
        "change-contract-a.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "A bounded non-bug change remains artifact-free, verifies repository/base/collisions, selects one isolated worktree creation, then is ready for execution without Linear or merge.",
      "assertions": [
        {
          "id": "admitted",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready",
          "critical": true
        },
        {
          "id": "artifact-free",
          "kind": "final-json-path-equals",
          "pointer": "/artifactMode",
          "expected": "off",
          "critical": true
        },
        {
          "id": "no-linear",
          "kind": "final-json-path-equals",
          "pointer": "/linearCallCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "repository",
          "kind": "final-json-path-equals",
          "pointer": "/canonicalRepositoryVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "base",
          "kind": "final-json-path-equals",
          "pointer": "/baseVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "collision-free",
          "kind": "final-json-path-equals",
          "pointer": "/collisionFree",
          "expected": true,
          "critical": true
        },
        {
          "id": "create-worktree",
          "kind": "final-json-path-equals",
          "pointer": "/worktreeAction",
          "expected": "create",
          "critical": true
        },
        {
          "id": "not-yet-delegated",
          "kind": "final-json-path-equals",
          "pointer": "/executionDelegated",
          "expected": false,
          "critical": true
        },
        {
          "id": "never-merge",
          "kind": "final-json-path-equals",
          "pointer": "/mergeAllowed",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "artifact-free-change-resumes-exact-worktree",
      "prompt": "Evaluate fixtures/change-contract-b.json recovery state. Do not mutate Git or files. Return exactly one JSON object using the keys status, artifactMode, linearCallCount, worktreeAction, exactTaskRecovered, headVerified, duplicateWorktreeCreated, and mergeAllowed.",
      "fixtures": [
        "change-contract-b.json"
      ],
      "capabilities": [
        "read-workspace"
