    },
    {
      "id": "artifact-free-change-authorizes-one-commit-after-review",
      "prompt": "Evaluate fixtures/change-contract-e.json after both uncommitted-diff reviews pass. Do not run Git. Return exactly one JSON object using the keys status, linearCallCount, sameDiffVerified, reviewsPassed, commitActionsAuthorized, commitSkill, pushOrSubmitAuthorized, and mergeAllowed.",
      "fixtures": [
        "change-contract-e.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Only the same verified and reviewed diff receives one bounded woostack-commit action; no broader source-control or merge authority is granted.",
