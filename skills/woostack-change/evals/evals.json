        {
          "id": "same-diff",
          "kind": "final-json-path-equals",
          "pointer": "/sameDiffVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "reviews",
          "kind": "final-json-path-equals",
          "pointer": "/reviewsPassed",
          "expected": true,
          "critical": true
