        {
          "id": "verification",
          "kind": "final-json-path-equals",
          "pointer": "/verificationObserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "spec-pass",
          "kind": "final-json-path-equals",
          "pointer": "/specificationReview",
          "expected": "pass",
          "critical": true
