    {
      "id": "artifact-free-change-blocks-identity-or-collision-drift",
      "prompt": "Evaluate every scenario in fixtures/change-contract-g.json independently before the next mutation. Return exactly one JSON object using the keys status, decisions, linearCallCount, repositoryMutationCount, duplicateWorktreeCreated, and mergeAllowed.",
      "fixtures": [
        "change-contract-g.json"
      ],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Repository, base, branch, worktree, head, scope, or collision drift blocks before mutation while the workflow remains Linear-free.",
      "assertions": [
        {
          "id": "blocked",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "all-blocked",
          "kind": "final-json-path-equals",
          "pointer": "/decisions",
          "expected": {
            "foreignRepository": "blocked",
            "baseDrift": "blocked",
            "branchCollision": "blocked",
            "worktreeCollision": "blocked",
            "headDrift": "blocked",
            "scopeExpansion": "blocked"
          },
          "critical": true
        },
        {
          "id": "no-linear",
          "kind": "final-json-path-equals",
