{
  "schemaVersion": 1,
  "skill": "woostack-respond",
  "cases": [
    {
      "id": "report-only-is-non-authoritative-and-never-mutates-linear",
      "prompt": "Classify this deterministic /woostack-respond --stop-after report outcome without calling providers, Git, GitHub, Linear, or writing files. Facts: the provider query has a valid output-bound receipt; one repository root cause is verified; all retained evidence is sanitized; no exact Linear artifact was supplied. Return exactly one JSON object with keys status, reportAuthority, reportEligible, fixContractKind, artifactLinked, linearReadCount, linearMutationCount, repositorySourceMutationCount, remediationDispatched, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The run is report-only: its sanitized report is eligible and explicitly non-authoritative, it proposes a bounded fix contract, and it performs no Linear read/mutation, repository-source mutation, remediation dispatch, or local development-artifact write.",
      "assertions": [
        {
          "id": "report-only-completes",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "report-only-complete",
          "critical": true
        },
        {
          "id": "report-is-not-authority",
          "kind": "final-json-path-equals",
          "pointer": "/reportAuthority",
          "expected": "non-authoritative",
          "critical": true
        },
        {
          "id": "sanitized-report-is-eligible",
          "kind": "final-json-path-equals",
          "pointer": "/reportEligible",
          "expected": true,
          "critical": true
        },
        {
          "id": "candidate-is-only-proposed",
          "kind": "final-json-path-equals",
          "pointer": "/fixContractKind",
          "expected": "proposed-fix-contract",
          "critical": true
        },
        {
          "id": "no-artifact-linked",
          "kind": "final-json-path-equals",
          "pointer": "/artifactLinked",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-linear-read-without-explicit-identity",
          "kind": "final-json-path-equals",
          "pointer": "/linearReadCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "report-only-no-linear-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/linearMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "report-only-no-source-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositorySourceMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "report-only-no-dispatch",
          "kind": "final-json-path-equals",
          "pointer": "/remediationDispatched",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-local-development-artifact",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "prepare-fix-continues-without-linear-artifact",
      "prompt": "Classify this deterministic /woostack-respond prepare-fix boundary without calling providers, Git, GitHub, Linear, or writing files. Facts: a sanitized non-authoritative report and one verified repository root cause exist; no Linear artifact was supplied and Linear MCP is unavailable; the user asks to proceed to remediation. Return exactly one JSON object with keys status, reasonCode, reportPreserved, artifactLinked, linearMutationCount, repositoryMutationCount, remediationDispatched, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The report remains valid non-authoritative evidence and the proposed bounded contract routes to woostack-fix for independent diagnosis and approval without any Linear prerequisite; this classification performs no Linear or repository mutation and creates no local development artifact.",
      "assertions": [
        {
          "id": "fix-handoff-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "fix-handoff-ready",
          "critical": true
        },
        {
          "id": "linear-is-optional",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "linear-artifact-optional",
          "critical": true
        },
        {
          "id": "safe-report-survives",
          "kind": "final-json-path-equals",
          "pointer": "/reportPreserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-artifact-linked",
          "kind": "final-json-path-equals",
          "pointer": "/artifactLinked",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-linear-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/linearMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "classification-does-not-mutate-repository",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "remediation-routed-to-fix",
          "kind": "final-json-path-equals",
          "pointer": "/remediationDispatched",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-local-fix-spec-plan",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "verified-issue-is-optional-artifact-context",
      "prompt": "Validate this synthetic prepare-fix handoff without calling a provider, Git, GitHub, Linear, or writing files. Facts: independent official-MCP reads uniquely verify issue stable client UUID 11111111-1111-4111-8111-111111111111, native issue UUID 22222222-2222-4222-8222-222222222222, exact URL https://linear.app/acme/issue/APP-90, and read receipt read-44; the bounded fix contract was explicitly approved and repository evidence is complete. Return exactly one JSON object with keys status, artifactLinked, issueClientId, issueNativeId, artifactReadBackVerified, repositoryMutationAuthorized, authorizationSource, assignmentRequired, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The repository handoff is authorized by the approved fix contract and repository evidence; the exact independently read issue is carried only as optional artifact context and no assignment or Linear lifecycle state is required.",
      "assertions": [
        {
          "id": "handoff-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready-for-repository-handoff",
          "critical": true
        },
        {
          "id": "artifact-linked",
          "kind": "final-json-path-equals",
          "pointer": "/artifactLinked",
          "expected": true,
          "critical": true
        },
        {
          "id": "stable-issue-id-retained",
          "kind": "final-json-path-equals",
          "pointer": "/issueClientId",
          "expected": "11111111-1111-4111-8111-111111111111",
          "critical": true
        },
        {
          "id": "native-issue-id-retained",
          "kind": "final-json-path-equals",
          "pointer": "/issueNativeId",
          "expected": "22222222-2222-4222-8222-222222222222",
          "critical": true
        },
        {
          "id": "artifact-read-back-is-complete",
          "kind": "final-json-path-equals",
          "pointer": "/artifactReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "repository-handoff-authorized",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationAuthorized",
          "expected": true,
          "critical": true
        },
        {
          "id": "approval-is-authority",
          "kind": "final-json-path-equals",
          "pointer": "/authorizationSource",
          "expected": "approved-fix-contract",
          "critical": true
        },
        {
          "id": "assignment-not-required",
          "kind": "final-json-path-equals",
          "pointer": "/assignmentRequired",
          "expected": false,
          "critical": true
        },
        {
          "id": "handoff-never-creates-local-authority",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "unknown-artifact-create-outcome-is-scoped",
      "prompt": "Classify this synthetic explicitly requested Linear artifact-create recovery boundary without calling a provider, Git, GitHub, Linear, or writing files. Facts: stable client UUID 33333333-3333-4333-8333-333333333333 was allocated before create; the create response timed out; an independent recovery read returns two issues carrying that UUID; the approved fix contract and repository path are otherwise valid. Return exactly one JSON object with keys status, reasonCode, retainedClientId, duplicateCreateAttempted, replacementUuidAllocated, artifactLinked, repositoryWorkBlocked, localFallbackUsed, and safeNextAction.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The optional artifact synchronization blocks as an ambiguous unknown outcome: preserve the stable UUID, create no duplicate or replacement, link no artifact, and require exact conflict resolution. The ambiguity does not invalidate the approved artifact-free repository workflow.",
      "assertions": [
        {
          "id": "artifact-sync-blocks",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "artifact-sync-blocked",
          "critical": true
        },
        {
          "id": "ambiguous-recovery-reason",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "ambiguous-artifact-create-read-back",
          "critical": true
        },
        {
          "id": "stable-id-is-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/retainedClientId",
          "expected": "33333333-3333-4333-8333-333333333333",
          "critical": true
        },
        {
          "id": "no-duplicate-create",
          "kind": "final-json-path-equals",
          "pointer": "/duplicateCreateAttempted",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-replacement-uuid",
          "kind": "final-json-path-equals",
          "pointer": "/replacementUuidAllocated",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-artifact-is-linked",
          "kind": "final-json-path-equals",
          "pointer": "/artifactLinked",
          "expected": false,
          "critical": true
        },
        {
          "id": "repository-work-remains-independent",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryWorkBlocked",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-local-recovery-authority",
          "kind": "final-json-path-equals",
          "pointer": "/localFallbackUsed",
