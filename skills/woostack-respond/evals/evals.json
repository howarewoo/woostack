{
  "schemaVersion": 1,
  "skill": "woostack-respond",
  "cases": [
    {
      "id": "report-only-is-non-authoritative-and-never-mutates-linear",
      "prompt": "Classify this deterministic /woostack-respond --stop-after report outcome without calling providers, Git, GitHub, Linear, or writing files. Facts: the provider query has a valid output-bound receipt; one repository root cause is verified; all retained evidence is sanitized; no exact managed issue was supplied. Return exactly one JSON object with keys status, reportAuthority, reportEligible, issueCandidateKind, issueBound, linearReadCount, linearMutationCount, repositorySourceMutationCount, remediationDispatched, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The run is report-only: its sanitized report is eligible and explicitly non-authoritative, it proposes a managed issue contract, and it performs no Linear read/mutation, repository-source mutation, remediation dispatch, or local development-artifact write.",
      "assertions": [
        {
          "id": "report-only-completes",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "report-only-complete",
          "critical": true
        },
        {
          "id": "report-is-not-authority",
          "kind": "final-json-path-equals",
          "pointer": "/reportAuthority",
          "expected": "non-authoritative",
          "critical": true
        },
        {
          "id": "sanitized-report-is-eligible",
          "kind": "final-json-path-equals",
          "pointer": "/reportEligible",
          "expected": true,
          "critical": true
        },
        {
          "id": "candidate-is-only-proposed",
          "kind": "final-json-path-equals",
          "pointer": "/issueCandidateKind",
          "expected": "proposed-managed-issue-contract",
          "critical": true
        },
        {
          "id": "no-issue-bound",
          "kind": "final-json-path-equals",
          "pointer": "/issueBound",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-linear-read-without-explicit-identity",
          "kind": "final-json-path-equals",
          "pointer": "/linearReadCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "report-only-no-linear-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/linearMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "report-only-no-source-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositorySourceMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "report-only-no-dispatch",
          "kind": "final-json-path-equals",
          "pointer": "/remediationDispatched",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-local-development-artifact",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "prepare-fix-rejects-remediation-without-managed-issue-capability",
      "prompt": "Classify this deterministic /woostack-respond prepare-fix boundary without calling providers, Git, GitHub, Linear, or writing files. Facts: a sanitized non-authoritative report and one verified root cause exist; no exact managed issue is bound; official host-exposed Linear MCP create/bind plus independent read-back capability is unavailable; the user asks to edit the repository now. Return exactly one JSON object with keys status, reasonCode, reportPreserved, issueBound, linearMutationCount, repositoryMutationCount, remediationDispatched, localFallbackUsed, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The report remains valid evidence but remediation blocks before any issue or repository mutation because one exact managed issue cannot be created/bound and independently verified; no local fallback is used.",
      "assertions": [
        {
          "id": "remediation-blocks",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "managed-issue-reason",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "managed-issue-bind-create-unavailable",
          "critical": true
        },
        {
          "id": "safe-report-survives",
          "kind": "final-json-path-equals",
          "pointer": "/reportPreserved",
          "expected": true,
          "critical": true
        },
        {
          "id": "no-issue-is-claimed",
          "kind": "final-json-path-equals",
          "pointer": "/issueBound",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-linear-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/linearMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "no-repository-mutation",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "no-remediation-dispatch",
          "kind": "final-json-path-equals",
          "pointer": "/remediationDispatched",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-alternate-authority",
          "kind": "final-json-path-equals",
          "pointer": "/localFallbackUsed",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-local-fix-spec-plan",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "verified-work-item-handoff-carries-exact-owner-state",
      "prompt": "Validate this synthetic prepare-fix handoff without calling a provider, Git, GitHub, Linear, or writing files. Facts: official-MCP independent reads uniquely verify work-item stable client UUID 11111111-1111-4111-8111-111111111111, native issue UUID 22222222-2222-4222-8222-222222222222, identifier APP-90, canonical repository https://github.com/acme/widgets, project membership absent, human assignee principal user-7, and current assignmentAccepted native comment comment-44 at revision 1 for engineer atlas/run run-9; the fix gate was explicitly approved and all receipts are complete. Return exactly one JSON object with keys status, issueClientId, issueNativeId, projectId, ownerKind, ownerPrincipalId, assignmentEventId, assignmentRevision, bindingReadBackVerified, repositoryMutationAuthorized, and localDevelopmentArtifactCreated.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "The repository-mutating handoff is admissible only with the exact projectless work-item IDs, verified human owner, current assignment receipt, explicit approval, and complete independent binding read-back.",
      "assertions": [
        {
          "id": "handoff-ready",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "ready-for-repository-handoff",
          "critical": true
        },
        {
          "id": "stable-issue-id-retained",
          "kind": "final-json-path-equals",
          "pointer": "/issueClientId",
          "expected": "11111111-1111-4111-8111-111111111111",
          "critical": true
        },
        {
          "id": "native-issue-id-retained",
          "kind": "final-json-path-equals",
          "pointer": "/issueNativeId",
          "expected": "22222222-2222-4222-8222-222222222222",
          "critical": true
        },
        {
          "id": "standalone-has-no-project",
          "kind": "final-json-path-equals",
          "pointer": "/projectId",
          "expected": null,
          "critical": true
        },
        {
          "id": "owner-kind-is-human",
          "kind": "final-json-path-equals",
          "pointer": "/ownerKind",
          "expected": "human",
          "critical": true
        },
        {
          "id": "owner-principal-is-exact",
          "kind": "final-json-path-equals",
          "pointer": "/ownerPrincipalId",
          "expected": "user-7",
          "critical": true
        },
        {
          "id": "assignment-receipt-is-carried",
          "kind": "final-json-path-equals",
          "pointer": "/assignmentEventId",
          "expected": "comment-44",
          "critical": true
        },
        {
          "id": "assignment-revision-is-carried",
          "kind": "final-json-path-equals",
          "pointer": "/assignmentRevision",
          "expected": 1,
          "critical": true
        },
        {
          "id": "binding-read-back-is-complete",
          "kind": "final-json-path-equals",
          "pointer": "/bindingReadBackVerified",
          "expected": true,
          "critical": true
        },
        {
          "id": "repository-handoff-authorized",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationAuthorized",
          "expected": true,
          "critical": true
        },
        {
          "id": "handoff-never-creates-local-authority",
          "kind": "final-json-path-equals",
          "pointer": "/localDevelopmentArtifactCreated",
          "expected": false,
          "critical": true
        }
      ]
    },
    {
      "id": "unknown-issue-create-outcome-fails-closed-without-duplicate",
      "prompt": "Classify this synthetic issue-create recovery boundary without calling a provider, Git, GitHub, Linear, or writing files. Facts: stable client UUID 33333333-3333-4333-8333-333333333333 was allocated before create; the create response timed out; an independent repository-scoped recovery read returns two ownership-valid native issues carrying that UUID. Return exactly one JSON object with keys status, reasonCode, retainedClientId, duplicateCreateAttempted, replacementUuidAllocated, issueBound, repositoryMutationCount, localFallbackUsed, and safeNextAction.",
      "fixtures": [],
      "capabilities": [
        "read-workspace"
      ],
      "expected": "Ambiguous read-back is an unknown mutation outcome: preserve the stable UUID, block, create no duplicate/replacement, perform no repository mutation, and require conflict resolution against the exact two native IDs.",
      "assertions": [
        {
          "id": "unknown-outcome-blocks",
          "kind": "final-json-path-equals",
          "pointer": "/status",
          "expected": "blocked",
          "critical": true
        },
        {
          "id": "ambiguous-recovery-reason",
          "kind": "final-json-path-equals",
          "pointer": "/reasonCode",
          "expected": "ambiguous-issue-create-read-back",
          "critical": true
        },
        {
          "id": "stable-id-is-preserved",
          "kind": "final-json-path-equals",
          "pointer": "/retainedClientId",
          "expected": "33333333-3333-4333-8333-333333333333",
          "critical": true
        },
        {
          "id": "no-duplicate-create",
          "kind": "final-json-path-equals",
          "pointer": "/duplicateCreateAttempted",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-replacement-uuid",
          "kind": "final-json-path-equals",
          "pointer": "/replacementUuidAllocated",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-issue-is-claimed-bound",
          "kind": "final-json-path-equals",
          "pointer": "/issueBound",
          "expected": false,
          "critical": true
        },
        {
          "id": "no-repository-mutation-after-unknown",
          "kind": "final-json-path-equals",
          "pointer": "/repositoryMutationCount",
          "expected": 0,
          "critical": true
        },
        {
          "id": "no-local-recovery-authority",
          "kind": "final-json-path-equals",
          "pointer": "/localFallbackUsed",
          "expected": false,
          "critical": true
        },
        {
          "id": "safe-action-is-exact-conflict-resolution",
          "kind": "final-json-path-equals",
          "pointer": "/safeNextAction",
          "expected": "resolve duplicate native issues for retained client UUID",
          "critical": true
        }
      ]
    }
  ]
}
