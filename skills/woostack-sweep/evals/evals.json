    {
      "id": "unsafe-worktree-retention-and-recovery",
      "prompt": "Classify a three-PR Sweep closeout without mutating source control. Explicit controller binding records PR 703, PR 704, and PR 705 as Sweep-owned. PR 703 is dirty with an unresolved index/diff; PR 704 is blocked by unresolved review blocker B704; PR 705 has an unknown removal outcome. Retain every unsafe worktree, rediscover complete evidence for PR 705 before any retry, and return exactly one JSON object with status, events, removed, rediscoveryRequired, and retained. Retained entries are ordered by PR and must expose actual leaves for pr, ownership, path, worktreeListing, branch, head, parent, dirtyIndexDiff, firstUnverifiedBoundary, safeNextAction, and reason.",
      "capabilities": ["read-workspace"],
      "expected": "All three worktrees remain retained and removed is empty; dirty, blocker, and unknown outcomes are never removed; PR 705 is rediscovered before its retry is blocked; every retained record exposes the exact recovery values.",
      "assertions": [
        {"id": "unsafe-status", "kind": "final-json-path-equals", "pointer": "/status", "expected": "blocked", "critical": true},
        {"id": "unsafe-removed-empty", "kind": "final-json-path-equals", "pointer": "/removed", "expected": [], "critical": true},
        {"id": "unsafe-event-order", "kind": "final-json-path-equals", "pointer": "/events", "expected": ["retain:703:dirty", "retain:704:blocker", "retain:705:unknown-outcome", "rediscover:705", "retry:705-blocked"], "critical": true},
        {"id": "rediscover-before-retry", "kind": "final-json-path-equals", "pointer": "/rediscoveryRequired", "expected": true, "critical": true},
        {"id": "dirty-pr", "kind": "final-json-path-equals", "pointer": "/retained/0/pr", "expected": 703, "critical": true},
        {"id": "dirty-owner", "kind": "final-json-path-equals", "pointer": "/retained/0/ownership", "expected": "sweep-owned", "critical": true},
        {"id": "dirty-path", "kind": "final-json-path-equals", "pointer": "/retained/0/path", "expected": "/tasks/pr-703", "critical": true},
        {"id": "dirty-listing", "kind": "final-json-path-equals", "pointer": "/retained/0/worktreeListing", "expected": "worktree-703", "critical": true},
        {"id": "dirty-branch", "kind": "final-json-path-equals", "pointer": "/retained/0/branch", "expected": "adam/pr-703", "critical": true},
        {"id": "dirty-head", "kind": "final-json-path-equals", "pointer": "/retained/0/head", "expected": "sha-703", "critical": true},
        {"id": "dirty-parent", "kind": "final-json-path-equals", "pointer": "/retained/0/parent", "expected": "main", "critical": true},
