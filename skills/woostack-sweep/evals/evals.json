        {"id": "caller-parent", "kind": "final-json-path-equals", "pointer": "/retained/0/parent", "expected": "main", "critical": true},
        {"id": "caller-index-diff", "kind": "final-json-path-equals", "pointer": "/retained/0/dirtyIndexDiff", "expected": "clean index/diff", "critical": true},
        {"id": "caller-boundary", "kind": "final-json-path-equals", "pointer": "/retained/0/firstUnverifiedBoundary", "expected": "caller-owned preservation", "critical": true},
        {"id": "caller-safe-action", "kind": "final-json-path-equals", "pointer": "/retained/0/safeNextAction", "expected": "leave caller-owned worktree intact", "critical": true},
        {"id": "primary-retained", "kind": "final-json-path-equals", "pointer": "/retained/1/worktree", "expected": "primary", "critical": true},
        {"id": "primary-pr", "kind": "final-json-path-equals", "pointer": "/retained/1/pr", "expected": null, "critical": true},
