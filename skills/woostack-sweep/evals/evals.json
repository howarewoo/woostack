        {"id": "blocker-path", "kind": "final-json-path-equals", "pointer": "/retained/1/path", "expected": "/tasks/pr-704", "critical": true},
        {"id": "blocker-listing", "kind": "final-json-path-equals", "pointer": "/retained/1/worktreeListing", "expected": "worktree-704", "critical": true},
        {"id": "blocker-branch", "kind": "final-json-path-equals", "pointer": "/retained/1/branch", "expected": "adam/pr-704", "critical": true},
        {"id": "blocker-head", "kind": "final-json-path-equals", "pointer": "/retained/1/head", "expected": "sha-704", "critical": true},
        {"id": "blocker-parent", "kind": "final-json-path-equals", "pointer": "/retained/1/parent", "expected": "main", "critical": true},
