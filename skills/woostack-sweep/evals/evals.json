        {"id": "primary-head", "kind": "final-json-path-equals", "pointer": "/retained/1/head", "expected": "sha-primary", "critical": true},
        {"id": "primary-parent", "kind": "final-json-path-equals", "pointer": "/retained/1/parent", "expected": "origin/main", "critical": true},
        {"id": "primary-index-diff", "kind": "final-json-path-equals", "pointer": "/retained/1/dirtyIndexDiff", "expected": "clean index/diff", "critical": true},
        {"id": "primary-boundary", "kind": "final-json-path-equals", "pointer": "/retained/1/firstUnverifiedBoundary", "expected": "primary worktree boundary", "critical": true},
        {"id": "primary-safe-action", "kind": "final-json-path-equals", "pointer": "/retained/1/safeNextAction", "expected": "retain primary worktree", "critical": true}
